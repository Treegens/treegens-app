+import mongoose from 'mongoose'
+
+/**
+ * One donation on its way from the foundation's bank account to $MGRO.
+ *
+ *   detected   a credit on the Mercury donations account (treegensfoundation.org)
+ *   held       waiting for an admin release (TREASURY_REQUIRE_APPROVAL, or a hold)
+ *   swept      Mercury sent the USD to the Stripe financial account (ACH)
+ *   onramped   Stripe paid the USD out as USDC to the treasury wallet on Base
+ *   bought     the treasury wallet swapped that USDC for $MGRO
+ *   settled    the $MGRO reached the Safe (or was retired through MangroveRetirement)
+ *   failed     a stage errored past its retries; an admin re-releases it
+ *
+ * Each stage keeps what it sent and what came back, so the public ledger can
+ * show the donation as a chain: $ in → USDC tx → swap tx → settle tx. Nothing
+ * about the donor is ever exposed: the counterparty is stored only as a hash,
+ * for de-duplication and support.
+ *
+ * ⛔ Amounts are integers (cents, USDC micro-units, MGRO wei as strings).
+ * Never a float on the way to a payment.
+ */
+export const DONATION_FLOW_STATUSES = [
+  'detected',
+  'held',
+  'swept',
+  'onramped',
+  'bought',
+  'settled',
+  'failed',
+] as const
+export type DonationFlowStatus = (typeof DONATION_FLOW_STATUSES)[number]
+
+export const STAGE_STATUSES = [
+  'pending',
+  'sent',
+  'settled',
+  'failed',
+  'skipped',
+] as const
+export type StageStatus = (typeof STAGE_STATUSES)[number]
+
+const stageBase = {
+  status: { type: String, enum: STAGE_STATUSES, default: 'pending' },
+  sentAt: { type: Date, required: false },
+  settledAt: { type: Date, required: false },
+  attempts: { type: Number, default: 0 },
+  error: { type: String, default: '' },
+  /** What a dry run WOULD have sent, verbatim, so an operator can check it. */
+  dryRun: { type: mongoose.Schema.Types.Mixed, required: false },
+}
+
+const donationFlowSchema = new mongoose.Schema(
+  {
+    status: {
+      type: String,
+      enum: DONATION_FLOW_STATUSES,
+      default: 'detected',
+      index: true,
+    },
+    mode: { type: String, enum: ['dry_run', 'live'], required: true },
+    amountCents: { type: Number, required: true, min: 1 },
+    currency: { type: String, default: 'usd' },
+    holdReason: { type: String, default: '' },
+    mercury: {
+      txId: { type: String, required: true },
+      accountId: { type: String, required: true },
+      kind: { type: String, default: '' },
+      postedAt: { type: Date, required: false },
+      /** sha256 of the counterparty name; never the name itself. */
+      counterpartyHash: { type: String, default: '' },
+      memo: { type: String, default: '' },
+    },
+    sweep: new mongoose.Schema(
+      {
+        ...stageBase,
+        mercuryPaymentId: { type: String, default: '' },
+        amountCents: { type: Number, default: 0 },
+        idempotencyKey: { type: String, default: '' },
+      },
+      { _id: false },
+    ),
+    onramp: new mongoose.Schema(
+      {
+        ...stageBase,
+        stripeOutboundPaymentId: { type: String, default: '' },
+        amountCents: { type: Number, default: 0 },
+        /** USDC base units (6 decimals) that reached the wallet. */
+        usdcMicro: { type: String, default: '0' },
+        txHash: { type: String, default: '' },
+        idempotencyKey: { type: String, default: '' },
+      },
+      { _id: false },
+    ),
+    swap: new mongoose.Schema(
+      {
+        ...stageBase,
+        usdcMicro: { type: String, default: '0' },
+        mgroWei: { type: String, default: '0' },
+        txHash: { type: String, default: '' },
+        route: { type: String, default: '' },
+        /** Flows swapped together in one transaction share a batch id. */
+        batchId: { type: String, default: '' },
+      },
+      { _id: false },
+    ),
+    settle: new mongoose.Schema(
+      {
+        ...stageBase,
+        mgroWei: { type: String, default: '0' },
+        to: { type: String, default: '' },
+        txHash: { type: String, default: '' },
+        retired: { type: Boolean, default: false },
+        tokenId: { type: Number, required: false },
+        batchId: { type: String, default: '' },
+      },
+      { _id: false },
+    ),
+    /** Bounded audit trail; the newest entries win. */
+    events: {
+      type: [
+        new mongoose.Schema(
+          {
+            at: { type: Date, default: Date.now },
+            stage: { type: String, default: '' },
+            message: { type: String, default: '' },
+          },
+          { _id: false },
+        ),
+      ],
+      default: [],
+    },
+  },
+  { timestamps: true },
+)
+
+donationFlowSchema.index({ 'mercury.txId': 1 }, { unique: true })
+donationFlowSchema.index({ status: 1, updatedAt: 1 })
+donationFlowSchema.index({ createdAt: -1 })
+
+export default mongoose.model('DonationFlow', donationFlowSchema)
diff --git a/src/models/OnchainEvent.ts b/src/models/OnchainEvent.ts
new file mode 100644
index 0000000..458b9d6
--- /dev/null
+++ b/src/models/OnchainEvent.ts
@@ -0,0 +1,78 @@
+import mongoose from 'mongoose'
+
+/**
+ * One row per on-chain event the public transparency ledger shows.
+ *
+ * Every amount on the open ledger traces back to one of these rows, and every
+ * row carries the transaction hash a reader can open on Basescan. The
+ * indexer writes them from Base logs and receipts; nothing here is typed in
+ * by hand.
+ */
+export const ONCHAIN_EVENT_KINDS = [
+  /** $MGRO Transfer from 0x0 — a reward minted to a planter, buyer or verifier. */
+  'mgro_mint',
+  /** $MGRO Transfer to 0x0 or 0x…dEaD — tokens retired for ever. */
+  'mgro_burn',
+  /** MintProposed on a minter — carries the evidenceURI naming the planting. */
+  'mint_proposed',
+  /** MintExecuted on a minter — the mint was released. */
+  'mint_executed',
+  /** VerifierRewardPaid on a minter — a verifier's 5% share inside a mint. */
+  'verifier_reward_paid',
+  /** MangrovesRetired on a retirement contract — a funder retired trees. */
+  'mgro_retired',
+  /** ERC-20 transfer inside a distribution tx — planter (95%) or verifier (5%) payout. */
+  'tgn_payout',
+] as const
+
+export type OnchainEventKind = (typeof ONCHAIN_EVENT_KINDS)[number]
+
+export type OnchainEventMeta = {
+  /** Submission the event pays for, when the chain or the ledger names one. */
+  submissionId?: string
+  /** 'planter' | 'buyer' | 'verifier' | 'funder' | 'other' */
+  role?: string
+  /** Planter reward tranche index (0-based) for vested MGRO mints. */
+  trancheIndex?: number
+  /** Minter proposal id. */
+  proposalId?: number
+  /** Minter evidence URI, e.g. treegens://submission/<id>/tranche/0 */
+  evidenceURI?: string
+  /** Approving count or weight recorded by MintExecuted. */
+  approvals?: string
+  /** USD the funder paid, copied from the distribution record. */
+  grossUsd?: number
+  /** Retirement: soulbound token id, beneficiary and metadata URI. */
+  tokenId?: number
+  beneficiary?: string
+  metadataURI?: string
+  sourceRef?: string
+}
+
+const onchainEventSchema = new mongoose.Schema(
+  {
+    chainId: { type: Number, required: true, default: 8453 },
+    txHash: { type: String, required: true, lowercase: true, trim: true },
+    logIndex: { type: Number, required: true, min: 0 },
+    blockNumber: { type: Number, required: true, min: 0, index: true },
+    blockTime: { type: Date, required: true, index: true },
+    /** Emitting contract (lowercase). */
+    contract: { type: String, required: true, lowercase: true, trim: true },
+    kind: { type: String, enum: ONCHAIN_EVENT_KINDS, required: true },
+    token: { type: String, enum: ['MGRO', 'TGN', 'ERC20', ''], default: '' },
+    from: { type: String, default: '', lowercase: true, trim: true },
+    to: { type: String, default: '', lowercase: true, trim: true, index: true },
+    /** Decimal wei string — never a float. */
+    amountWei: { type: String, required: true, default: '0' },
+    meta: { type: mongoose.Schema.Types.Mixed, default: {} },
+  },
+  { timestamps: true },
+)
+
+onchainEventSchema.index({ txHash: 1, logIndex: 1 }, { unique: true })
+onchainEventSchema.index({ kind: 1, blockTime: -1 })
+onchainEventSchema.index({ blockTime: -1, logIndex: -1 })
+onchainEventSchema.index({ 'meta.submissionId': 1 }, { sparse: true })
+onchainEventSchema.index({ 'meta.proposalId': 1 }, { sparse: true })
+
+export default mongoose.model('OnchainEvent', onchainEventSchema)
