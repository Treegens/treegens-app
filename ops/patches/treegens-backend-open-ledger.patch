+  return parts.length ? parts[parts.length - 1] : ''
+}
+
+function isoOrNull(d: unknown): string | null {
+  if (!d) return null
+  const date = d instanceof Date ? d : new Date(String(d))
+  return Number.isNaN(date.getTime()) ? null : date.toISOString()
+}
