 DISABLE_NEARBY_SCENE_COMPARISON=false
+
+# --- Donation pipeline: treegensfoundation.org → Mercury → Stripe → USDC → $MGRO → locked ---
+# docs/TREASURY_PIPELINE.md is the runbook. Nothing moves until every key for a
+# stage exists AND TREASURY_PIPELINE_MODE=live; dry_run records what would be sent.
+# Console: GET/POST /api/admin/treasury/* (bearer ADMIN_API_TOKEN).
