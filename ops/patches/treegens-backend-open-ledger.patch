+const MAX_LOG_SPAN = 100_000
+/** How long a send waits for its receipt before leaving confirmation to the next tick. */
+const RECEIPT_WAIT_MS = 90_000
+
+export interface TickSummary {
+  at: string
+  mode: PipelineMode
+  ranUnderLease: boolean
+  detected: number
+  held: number
+  swept: number
+  onramped: number
+  bought: number
+  settled: number
+  failed: number
+  errors: string[]
