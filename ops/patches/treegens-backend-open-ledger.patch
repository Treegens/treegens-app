diff --git a/src/services/transparencyIndexerService.ts b/src/services/transparencyIndexerService.ts
new file mode 100644
index 0000000..ebf25c4
--- /dev/null
+++ b/src/services/transparencyIndexerService.ts
@@ -0,0 +1,859 @@
+import { ethers } from 'ethers'
+import env from '../config/environment'
+import HealthCheck from '../models/HealthCheck'
+import OnchainEvent, { type OnchainEventMeta } from '../models/OnchainEvent'
+import OnchainIndexerState from '../models/OnchainIndexerState'
+import OnchainTxIngest from '../models/OnchainTxIngest'
+import RewardAllocation from '../models/RewardAllocation'
+import Submission from '../models/Submission'
+import TgnDistribution from '../models/TgnDistribution'
+import { MongoLease, runUnderLease } from '../utils/mongoLease'
+import {
+  classifyMgroTransfer,
+  isRangeTooLargeError,
+  parseEvidenceURI,
+  parseSubmissionIdFromUrl,
+  payoutRoleFor,
+  ZERO_ADDRESS,
+} from '../utils/transparencyFormat'
+import { jsonRpcProvider } from './verifierMinterService'
+
+/**
+ * Public-ledger indexer.
+ *
+ * Reads Base once and writes one OnchainEvent per fact the transparency site
+ * shows, so every figure on it is a sum over rows that each carry a tx hash:
+ *
+ *   • $MGRO Transfer from 0x0            → `mgro_mint`  (reward to planter/buyer/verifier)
+ *   • $MGRO Transfer to 0x0 or 0x…dEaD   → `mgro_burn`  (retired for ever)
+ *   • MintProposed / MintExecuted / VerifierRewardPaid on every minter
+ *     (V4, V6, AutoMinterV7 and the revoked ones). The proposal's evidenceURI
+ *     (`treegens://submission/<id>/tranche/<n>` …) is how the chain itself
+ *     names the planting a mint pays for, so mints are linked to plantings
+ *     from on-chain data first and from our ledger only as a fallback.
+ *   • MangrovesRetired on the MangroveRetirement contracts → `mgro_retired`,
+ *     naming the planting a funder retired $MGRO for (world.treegens.app).
+ *   • ERC-20 Transfer logs inside each completed TgnDistribution's payout
+ *     receipts → `tgn_payout` (planter 95% / verifier 5%). Amounts come from
+ *     the receipt, not from what the relayer told us it sent.
+ *
+ * Read-only on the chain. Idempotent: rows are upserted on (txHash, logIndex);
+ * receipts are tracked in OnchainTxIngest so a missing one is retried a
+ * bounded number of times. One process indexes at a time (Mongo lease).
+ */
+
+const TRANSFER_TOPIC = ethers.id('Transfer(address,address,uint256)')
+const ZERO_TOPIC = ethers.zeroPadValue(ethers.ZeroAddress, 32)
+const DEAD_TOPIC = ethers.zeroPadValue(
+  '0x000000000000000000000000000000000000dEaD',
+  32,
+)
+
+const ERC20_TRANSFER_ABI = [
+  'event Transfer(address indexed from, address indexed to, uint256 value)',
+]
+const MINTER_EVENTS_ABI = [
+  'event MintProposed(uint256 indexed proposalId, address indexed proposer, address indexed to, uint256 amount, string evidenceURI)',
+  'event MintExecuted(uint256 indexed proposalId, address indexed to, uint256 amount, uint256 approvals)',
+  'event VerifierRewardPaid(uint256 indexed proposalId, address indexed verifier, uint256 amount)',
+]
+const RETIREMENT_EVENTS_ABI = [
+  'event MangrovesRetired(uint256 indexed tokenId, address indexed beneficiary, uint256 mgroAmount, string metadataURI, bytes32 indexed sourceRef)',
+]
+
+const erc20Iface = new ethers.Interface(ERC20_TRANSFER_ABI)
+const minterIface = new ethers.Interface(MINTER_EVENTS_ABI)
+const retirementIface = new ethers.Interface(RETIREMENT_EVENTS_ABI)
+const MINT_PROPOSED_TOPIC = minterIface.getEvent('MintProposed')!.topicHash
+const MINT_EXECUTED_TOPIC = minterIface.getEvent('MintExecuted')!.topicHash
+const VERIFIER_PAID_TOPIC =
+  minterIface.getEvent('VerifierRewardPaid')!.topicHash
+const RETIRED_TOPIC = retirementIface.getEvent('MangrovesRetired')!.topicHash
+
+/** The $TGN the world site pays in, whatever this deploy's TGN default says. */
+const KNOWN_TGN = ['0xd75dfa972c6136f1c594fec1945302f885e1ab29']
+
+const MAX_RECEIPT_ATTEMPTS = 6
+const MIN_CHUNK = 100
+const LEASE_TTL_MS = 10 * 60_000
+
+async function mapLimit<T, R>(
+  items: T[],
+  limit: number,
+  fn: (item: T) => Promise<R>,
+): Promise<R[]> {
+  const out: R[] = new Array(items.length)
+  let next = 0
+  const workers = Array.from(
+    { length: Math.min(limit, items.length) },
+    async () => {
+      while (next < items.length) {
+        const i = next++
+        out[i] = await fn(items[i])
+      }
+    },
+  )
+  await Promise.all(workers)
+  return out
+}
+
+type EventRow = {
+  chainId: number
+  txHash: string
+  logIndex: number
+  blockNumber: number
+  blockTime: Date
+  contract: string
+  kind: string
+  token: 'MGRO' | 'TGN' | 'ERC20' | ''
+  from: string
+  to: string
+  amountWei: string
+  meta: OnchainEventMeta
+}
+
+export default class TransparencyIndexerService {
+  private provider: ethers.JsonRpcProvider
+
+  private readonly mgro: string
+
+  private readonly tgnAddresses: Set<string>
+
+  private readonly minters: string[]
+
+  private readonly retirements: string[]
+
+  private readonly chainId = 8453
+
+  private readonly confirmations: number
+
+  private chunkSize: number
+
+  private readonly pollMs: number
+
+  private readonly startBlock: number
+
+  private readonly cursorKey: string
+
+  private readonly lease = new MongoLease('ledger-indexer', LEASE_TTL_MS)
+
+  private timer: NodeJS.Timeout | null = null
+
+  private syncInProgress = false
+
+  private lastSyncAt: Date | null = null
+
+  private lastError = ''
+
+  private lastHead = 0
+
+  private readonly blockTimes = new Map<number, Date>()
+
+  constructor() {
+    const rpcUrl = env.BASE_RPC_URL || env.BASE_SEPOLIA_RPC_URL
+    if (!rpcUrl) {
+      throw new Error('BASE_RPC_URL is required for the ledger indexer')
+    }
+    this.provider = jsonRpcProvider(rpcUrl)
+    this.mgro = env.MGRO_TOKEN_ADDRESS.toLowerCase()
+    this.tgnAddresses = new Set([
+      env.TGN_TOKEN_ADDRESS.toLowerCase(),
+      ...KNOWN_TGN,
+    ])
+    this.minters = env.TRANSPARENCY_MINTER_ADDRESSES.map(a => a.toLowerCase())
+    this.retirements = env.TRANSPARENCY_RETIREMENT_ADDRESSES.map(a =>
+      a.toLowerCase(),
+    )
+    this.confirmations = env.LEDGER_INDEXER_CONFIRMATIONS
+    this.chunkSize = env.LEDGER_INDEXER_CHUNK_SIZE
+    this.pollMs = env.LEDGER_INDEXER_POLL_MS
+    this.startBlock = env.LEDGER_INDEXER_START_BLOCK
+    this.cursorKey = `ledger:${this.chainId}:${this.mgro}`
+  }
+
+  start() {
+    if (this.timer) return
+    const tick = async () => {
+      try {
+        const run = await runUnderLease(this.lease, () => this.syncOnce())
+        if (!run.ran) this.lastError = ''
+      } catch (error: any) {
+        this.lastError = error?.message || String(error)
+        console.error('[LedgerIndexer] tick failed', {
+          message: this.lastError,
+        })
+      } finally {
+        this.timer = setTimeout(tick, this.pollMs)
+        this.timer.unref()
+      }
+    }
+    // After the connection and the first health probe, not racing them.
+    this.timer = setTimeout(tick, 20_000)
+    this.timer.unref()
+  }
+
+  stop() {
+    if (!this.timer) return
+    clearTimeout(this.timer)
+    this.timer = null
+  }
+
+  /** One full pass: log scan to the confirmed head, then payout receipts. */
+  async syncOnce() {
+    if (this.syncInProgress) return
+    this.syncInProgress = true
+    try {
+      await this.syncLogs()
+      await this.syncPayoutReceipts()
+      await this.linkFromLedger()
+      this.lastSyncAt = new Date()
+      this.lastError = ''
+    } catch (error: any) {
+      this.lastError = error?.message || String(error)
+      throw error
+    } finally {
+      this.syncInProgress = false
+    }
+  }
+
+  async getStatus() {
+    const state = await OnchainIndexerState.findOne({
+      key: this.cursorKey,
+    }).lean()
+    const lastProcessedBlock = Number(state?.lastProcessedBlock || 0)
+    return {
+      enabled: true,
+      cursorKey: this.cursorKey,
+      startBlock: this.startBlock,
+      lastProcessedBlock,
+      head: this.lastHead,
+      lagBlocks: this.lastHead
+        ? Math.max(0, this.lastHead - lastProcessedBlock)
+        : null,
+      lastSyncAt: this.lastSyncAt,
+      lastError: this.lastError || null,
+      contracts: {
+        mgro: this.mgro,
+        tgn: [...this.tgnAddresses],
+        minters: this.minters,
+        retirements: this.retirements,
+      },
+    }
+  }
+
+  // ------------------------------------------------------------ log scan --
+
+  private async syncLogs() {
+    const head = await this.provider.getBlockNumber()
+    this.lastHead = head
+    const confirmedHead = Math.max(0, head - this.confirmations)
+    let current = await this.nextFromBlock()
+    while (current <= confirmedHead) {
+      const toBlock = Math.min(confirmedHead, current + this.chunkSize - 1)
+      try {
+        await this.processRange(current, toBlock)
+      } catch (error) {
+        if (isRangeTooLargeError(error) && this.chunkSize > MIN_CHUNK) {
+          this.chunkSize = Math.max(MIN_CHUNK, Math.floor(this.chunkSize / 2))
+          console.warn('[LedgerIndexer] shrinking chunk size', {
+            chunkSize: this.chunkSize,
+          })
+          continue
+        }
+        throw error
+      }
+      current = toBlock + 1
+    }
+  }
+
+  private async nextFromBlock() {
+    const state = await OnchainIndexerState.findOne({
+      key: this.cursorKey,
+    }).lean()
+    if (!state) return this.startBlock
+    return Math.max(this.startBlock, Number(state.lastProcessedBlock || 0) + 1)
+  }
+
+  private async processRange(fromBlock: number, toBlock: number) {
+    const logsOf = (address: string | string[], topics: any[]) =>
+      this.provider.getLogs({ address, fromBlock, toBlock, topics })
+    // Mints and burns only: filtering on the zero / dEaD topics keeps a busy
+    // token's ordinary transfers out of the response entirely.
+    const [mintLogs, burn0Logs, burnDeadLogs, minterLogs, retirementLogs] =
+      await Promise.all([
+        logsOf(this.mgro, [TRANSFER_TOPIC, ZERO_TOPIC]),
+        logsOf(this.mgro, [TRANSFER_TOPIC, null, ZERO_TOPIC]),
+        logsOf(this.mgro, [TRANSFER_TOPIC, null, DEAD_TOPIC]),
+        this.minters.length
+          ? logsOf(this.minters, [
+              [MINT_PROPOSED_TOPIC, MINT_EXECUTED_TOPIC, VERIFIER_PAID_TOPIC],
+            ])
+          : Promise.resolve([] as ethers.Log[]),
+        this.retirements.length
+          ? logsOf(this.retirements, [RETIRED_TOPIC])
+          : Promise.resolve([] as ethers.Log[]),
+      ])
+
+    const rows: EventRow[] = []
+    const blocks = new Set<number>()
+    const base = (log: ethers.Log) => ({
+      chainId: this.chainId,
+      txHash: log.transactionHash.toLowerCase(),
+      logIndex: log.index,
+      blockNumber: log.blockNumber,
+      blockTime: new Date(0),
+      contract: String(log.address).toLowerCase(),
+    })
+
+    for (const log of [...mintLogs, ...burn0Logs, ...burnDeadLogs]) {
+      const parsed = this.safeParse(erc20Iface, log)
+      if (!parsed) continue
+      const from = String(parsed.args.from).toLowerCase()
+      const to = String(parsed.args.to).toLowerCase()
+      const kind = classifyMgroTransfer(from, to)
+      if (!kind) continue
+      const value = BigInt(parsed.args.value.toString())
+      if (value <= 0n) continue
+      blocks.add(log.blockNumber)
+      rows.push({
+        ...base(log),
+        kind,
+        token: 'MGRO',
+        from,
+        to,
+        amountWei: value.toString(),
+        meta: kind === 'mgro_burn' ? { role: 'funder' } : {},
+      })
+    }
+
+    for (const log of minterLogs) {
+      const parsed = this.safeParse(minterIface, log)
+      if (!parsed) continue
+      blocks.add(log.blockNumber)
+      if (parsed.name === 'MintProposed') {
+        const evidenceURI = String(parsed.args.evidenceURI || '')
+        const ref = parseEvidenceURI(evidenceURI)
+        rows.push({
+          ...base(log),
+          kind: 'mint_proposed',
+          token: '',
+          from: String(parsed.args.proposer).toLowerCase(),
+          to: String(parsed.args.to).toLowerCase(),
+          amountWei: BigInt(parsed.args.amount.toString()).toString(),
+          meta: {
+            proposalId: Number(parsed.args.proposalId),
+            evidenceURI,
+            ...(ref?.submissionId ? { submissionId: ref.submissionId } : {}),
+            ...(ref ? { role: ref.role } : {}),
+            ...(ref?.trancheIndex !== undefined
+              ? { trancheIndex: ref.trancheIndex }
+              : {}),
+          },
+        })
+      } else if (parsed.name === 'MintExecuted') {
+        rows.push({
+          ...base(log),
+          kind: 'mint_executed',
+          token: '',
+          from: '',
+          to: String(parsed.args.to).toLowerCase(),
+          amountWei: BigInt(parsed.args.amount.toString()).toString(),
+          meta: {
+            proposalId: Number(parsed.args.proposalId),
+            approvals: BigInt(parsed.args.approvals.toString()).toString(),
+          },
+        })
+      } else if (parsed.name === 'VerifierRewardPaid') {
+        rows.push({
+          ...base(log),
+          kind: 'verifier_reward_paid',
+          token: 'MGRO',
+          from: '',
+          to: String(parsed.args.verifier).toLowerCase(),
+          amountWei: BigInt(parsed.args.amount.toString()).toString(),
+          meta: {
+            proposalId: Number(parsed.args.proposalId),
+            role: 'verifier',
+          },
+        })
+      }
+    }
+
+    for (const log of retirementLogs) {
+      const parsed = this.safeParse(retirementIface, log)
+      if (!parsed) continue
+      blocks.add(log.blockNumber)
+      const metadataURI = String(parsed.args.metadataURI || '')
+      const submissionId = parseSubmissionIdFromUrl(metadataURI)
+      rows.push({
+        ...base(log),
+        kind: 'mgro_retired',
+        token: 'MGRO',
+        from: '',
+        to: String(parsed.args.beneficiary).toLowerCase(),
+        amountWei: BigInt(parsed.args.mgroAmount.toString()).toString(),
+        meta: {
+          tokenId: Number(parsed.args.tokenId),
+          beneficiary: String(parsed.args.beneficiary).toLowerCase(),
+          metadataURI,
+          sourceRef: String(parsed.args.sourceRef),
+          role: 'funder',
+          ...(submissionId ? { submissionId } : {}),
+        },
+      })
+    }
+
+    if (rows.length) {
+      await this.fillBlockTimes(blocks)
+      for (const row of rows) {
+        row.blockTime = this.blockTimes.get(row.blockNumber) || new Date(0)
+      }
+      await this.upsertRows(rows)
+      await this.linkFromChain([...new Set(rows.map(r => r.txHash))])
+    }
+
+    await OnchainIndexerState.updateOne(
+      { key: this.cursorKey },
+      {
+        $set: {
+          key: this.cursorKey,
+          lastProcessedBlock: toBlock,
+          'meta.lastRangeRows': rows.length,
+          'meta.lastRangeAt': new Date(),
+        },
+      },
+      { upsert: true },
+    )
+  }
+
+  private safeParse(iface: ethers.Interface, log: ethers.Log) {
+    try {
+      return iface.parseLog({ topics: [...log.topics], data: log.data })
+    } catch {
+      return null
+    }
+  }
+
+  private async fillBlockTimes(blocks: Set<number>) {
+    const missing = [...blocks].filter(b => !this.blockTimes.has(b))
+    await mapLimit(missing, 4, async blockNumber => {
+      const block = await this.provider.getBlock(blockNumber)
+      if (block) {
+        this.blockTimes.set(
+          blockNumber,
+          new Date(Number(block.timestamp) * 1000),
+        )
+      }
+    })
+    if (this.blockTimes.size > 5000) {
+      const keys = [...this.blockTimes.keys()].sort((a, b) => a - b)
+      for (const k of keys.slice(0, keys.length - 2000))
+        this.blockTimes.delete(k)
+    }
+  }
+
+  private async upsertRows(rows: EventRow[]) {
+    if (!rows.length) return
+    await OnchainEvent.bulkWrite(
+      rows.map(row => ({
+        updateOne: {
+          filter: { txHash: row.txHash, logIndex: row.logIndex },
+          update: { $setOnInsert: row },
+          upsert: true,
+        },
+      })),
+      { ordered: false },
+    )
+  }
+
+  // ------------------------------------------------------------- linking --
+
+  /**
+   * Give each `mgro_mint` / `mgro_burn` in these transactions the planting it
+   * belongs to, from on-chain facts in the same transaction:
+   *   mint  ← MintExecuted (same tx, same recipient) ← its MintProposed's
+   *           evidenceURI; VerifierRewardPaid (same tx, same recipient) makes
+   *           it a verifier share of that proposal.
+   *   burn  ← MangrovesRetired in the same tx (the metadata URI names the
+   *           planting).
+   */
+  async linkFromChain(txHashes: string[]) {
+    if (!txHashes.length) return
+    const events = await OnchainEvent.find({ txHash: { $in: txHashes } }).lean()
+    const byTx = new Map<string, any[]>()
+    for (const e of events) {
+      const list = byTx.get(e.txHash) || []
+      list.push(e)
+      byTx.set(e.txHash, list)
+    }
+
+    const proposalIds = [
+      ...new Set(
+        events
+          .filter(
+            e =>
+              e.kind === 'mint_executed' || e.kind === 'verifier_reward_paid',
+          )
+          .map(e => Number(e.meta?.proposalId))
+          .filter(n => Number.isFinite(n)),
+      ),
+    ]
+    const proposals = proposalIds.length
+      ? await OnchainEvent.find({
+          kind: 'mint_proposed',
+          'meta.proposalId': { $in: proposalIds },
+        }).lean()
+      : []
+    const proposalMeta = new Map<string, OnchainEventMeta>()
+    for (const p of proposals) {
+      proposalMeta.set(`${p.contract}:${p.meta?.proposalId}`, p.meta || {})
+    }
+
+    const ops: any[] = []
+    for (const [, list] of byTx) {
+      const mints = list.filter(
+        e => e.kind === 'mgro_mint' && !e.meta?.submissionId,
+      )
+      const burns = list.filter(
+        e => e.kind === 'mgro_burn' && !e.meta?.submissionId,
+      )
+      if (!mints.length && !burns.length) continue
+      const executed = list.filter(e => e.kind === 'mint_executed')
+      const paid = list.filter(e => e.kind === 'verifier_reward_paid')
+      const retired = list.find(e => e.kind === 'mgro_retired')
+
+      for (const mint of mints) {
+        const to = String(mint.to).toLowerCase()
+        const share = paid.find(p => String(p.to).toLowerCase() === to)
+        const exec =
+          executed.find(e => String(e.to).toLowerCase() === to) ||
+          (share
+            ? executed.find(
+                e =>
+                  Number(e.meta?.proposalId) === Number(share.meta?.proposalId),
+              )
+            : undefined) ||
+          (executed.length === 1 ? executed[0] : undefined)
+        const key = exec ? `${exec.contract}:${exec.meta?.proposalId}` : null
+        const prop = key ? proposalMeta.get(key) : undefined
+        const set: Record<string, unknown> = {}
+        if (prop?.submissionId) set['meta.submissionId'] = prop.submissionId
+        if (prop?.evidenceURI) set['meta.evidenceURI'] = prop.evidenceURI
+        if (exec?.meta?.proposalId !== undefined)
+          set['meta.proposalId'] = exec.meta.proposalId
+        if (exec?.meta?.approvals) set['meta.approvals'] = exec.meta.approvals
+        if (share) {
+          set['meta.role'] = 'verifier'
+        } else if (prop?.role && prop.role !== 'unknown') {
+          set['meta.role'] = prop.role
+          if (prop.trancheIndex !== undefined)
+            set['meta.trancheIndex'] = prop.trancheIndex
+        } else if (exec) {
+          set['meta.role'] = 'planter'
+        }
+        if (Object.keys(set).length) {
+          ops.push({
+            updateOne: { filter: { _id: mint._id }, update: { $set: set } },
+          })
+        }
+      }
+
+      if (retired) {
+        for (const burn of burns) {
+          const set: Record<string, unknown> = {
+            'meta.role': 'funder',
+            'meta.tokenId': retired.meta?.tokenId,
+            'meta.beneficiary': retired.meta?.beneficiary,
+          }
+          if (retired.meta?.submissionId)
+            set['meta.submissionId'] = retired.meta.submissionId
+          ops.push({
+            updateOne: { filter: { _id: burn._id }, update: { $set: set } },
+          })
+        }
+      }
+    }
+    if (ops.length) await OnchainEvent.bulkWrite(ops, { ordered: false })
+  }
+
+  /**
+   * Fallback for mints the chain did not explain (legacy direct mints, a
+   * proposal from before the start block): our own ledger's transaction
+   * hashes on RewardAllocation tranches / verifier claims, Submission and
+   * HealthCheck mint fields. Bounded per tick.
+   */
+  async linkFromLedger(limit = 200) {
+    const mints = await OnchainEvent.find({
+      kind: 'mgro_mint',
+      'meta.submissionId': { $exists: false },
+      'meta.ledgerChecked': { $ne: true },
+    })
+      .sort({ blockNumber: -1 })
+      .limit(limit)
+      .lean()
+    if (!mints.length) return
+    const hashes = [...new Set(mints.map(m => m.txHash))]
+    const [allocations, submissions, healthChecks] = await Promise.all([
+      RewardAllocation.find(
+        {
+          $or: [
+            { 'tranches.txHash': { $in: hashes } },
+            { 'verifierClaims.txHash': { $in: hashes } },
+          ],
+        },
+        { submissionId: 1, tranches: 1, verifierClaims: 1 },
+      ).lean(),
+      Submission.find(
+        {
+          $or: [
+            { mintProposalTxHash: { $in: hashes } },
+            { mintExecuteTxHash: { $in: hashes } },
+          ],
+        },
+        { mintProposalTxHash: 1, mintExecuteTxHash: 1 },
+      ).lean(),
+      HealthCheck.find(
+        {
+          $or: [
+            { mintProposalTxHash: { $in: hashes } },
+            { mintExecuteTxHash: { $in: hashes } },
+          ],
+        },
+        {
+          submissionId: 1,
+          mintProposalTxHash: 1,
+          mintExecuteTxHash: 1,
+          mintTrancheIndex: 1,
+        },
+      ).lean(),
+    ])
+    const lower = (v: unknown) => String(v || '').toLowerCase()
+    const ops: any[] = []
+    for (const mint of mints) {
+      const set: Record<string, unknown> = { 'meta.ledgerChecked': true }
+      for (const alloc of allocations as any[]) {
+        const tranche = (alloc.tranches || []).find(
+          (t: any) => lower(t.txHash) === mint.txHash,
+        )
+        const claim = (alloc.verifierClaims || []).find(
+          (c: any) => lower(c.txHash) === mint.txHash,
+        )
+        if (!tranche && !claim) continue
+        set['meta.submissionId'] = String(alloc.submissionId)
+        set['meta.role'] = tranche ? 'planter' : 'verifier'
+        if (tranche) set['meta.trancheIndex'] = tranche.index
+        break
+      }
+      if (!set['meta.submissionId']) {
+        const sub = (submissions as any[]).find(
+          s =>
+            lower(s.mintProposalTxHash) === mint.txHash ||
+            lower(s.mintExecuteTxHash) === mint.txHash,
+        )
+        if (sub) {
+          set['meta.submissionId'] = String(sub._id)
+          set['meta.role'] = 'planter'
+          set['meta.trancheIndex'] = 0
+        }
+      }
+      if (!set['meta.submissionId']) {
+        const hc = (healthChecks as any[]).find(
+          h =>
+            lower(h.mintProposalTxHash) === mint.txHash ||
+            lower(h.mintExecuteTxHash) === mint.txHash,
+        )
+        if (hc) {
+          set['meta.submissionId'] = String(hc.submissionId)
+          set['meta.role'] = 'planter'
+          if (typeof hc.mintTrancheIndex === 'number')
+            set['meta.trancheIndex'] = hc.mintTrancheIndex
+        }
+      }
+      ops.push({
+        updateOne: { filter: { _id: mint._id }, update: { $set: set } },
+      })
+    }
+    if (ops.length) await OnchainEvent.bulkWrite(ops, { ordered: false })
+  }
+
+  // ------------------------------------------------------- payout receipts --
+
+  /**
+   * Read the receipts of completed TgnDistribution payouts and record the
+   * token legs that reached the planter and the verifiers. Also stamps the
+   * funder's `mgro_burn` row (MGRO rail) with the planting it retired.
+   */
+  async syncPayoutReceipts(limit = 40) {
+    const completed = await TgnDistribution.find(
+      { planterTx: { $nin: ['', null] } },
+      {
+        submissionId: 1,
+        grossUsd: 1,
+        planterWallet: 1,
+        planterTx: 1,
+        verifiers: 1,
+      },
+    )
+      .sort({ distributedAt: -1 })
+      .limit(500)
+      .lean()
+    if (!completed.length) return
+
+    const byTx = new Map<string, (typeof completed)[number]>()
+    for (const d of completed) {
+      const hashes = [d.planterTx, ...(d.verifiers || []).map(v => v.tx)]
+      for (const raw of hashes) {
+        const h = String(raw || '')
+          .trim()
+          .toLowerCase()
+        if (/^0x[a-f0-9]{64}$/.test(h) && !byTx.has(h)) byTx.set(h, d)
+      }
+    }
+    if (!byTx.size) return
+
+    const done = await OnchainTxIngest.find(
+      {
+        txHash: { $in: [...byTx.keys()] },
+        $or: [
+          { status: { $in: ['ingested', 'invalid'] } },
+          { attempts: { $gte: MAX_RECEIPT_ATTEMPTS } },
+        ],
+      },
+      { txHash: 1 },
+    ).lean()
+    const skip = new Set(done.map(d => d.txHash))
+    const pending = [...byTx.keys()].filter(h => !skip.has(h)).slice(0, limit)
+
+    await mapLimit(pending, 3, async txHash => {
+      const distribution = byTx.get(txHash)!
+      try {
+        const receipt = await this.provider.getTransactionReceipt(txHash)
+        if (!receipt) {
+          await this.markIngest(
+            txHash,
+            distribution,
+            'not_found',
+            0,
+            'receipt not found',
+          )
+          return
+        }
+        const written = await this.ingestPayoutReceipt(receipt, distribution)
+        await this.markIngest(txHash, distribution, 'ingested', written, '')
+      } catch (error: any) {
+        await this.markIngest(
+          txHash,
+          distribution,
+          'failed',
+          0,
+          error?.message || String(error),
+        )
+      }
+    })
+  }
+
+  private async markIngest(
+    txHash: string,
+    distribution: { submissionId: unknown },
+    status: 'ingested' | 'not_found' | 'failed' | 'invalid',
+    eventsWritten: number,
+    lastError: string,
+  ) {
+    await OnchainTxIngest.updateOne(
+      { txHash },
+      {
+        $set: {
+          txHash,
+          source: 'tgn_distribution',
+          submissionId: String(distribution.submissionId),
+          status,
+          eventsWritten,
+          lastError: lastError.slice(0, 500),
+        },
+        $inc: { attempts: 1 },
+      },
+      { upsert: true },
+    )
+  }
+
+  private async ingestPayoutReceipt(
+    receipt: ethers.TransactionReceipt,
+    distribution: {
+      submissionId: unknown
+      grossUsd?: number
+      planterWallet?: string
+      verifiers?: { wallet: string }[]
+    },
+  ): Promise<number> {
+    if (receipt.status !== 1) return 0
+    await this.fillBlockTimes(new Set([receipt.blockNumber]))
+    const blockTime = this.blockTimes.get(receipt.blockNumber) || new Date(0)
+    const submissionId = String(distribution.submissionId)
+    const rows: EventRow[] = []
+    const burnStamps: any[] = []
+
+    for (const log of receipt.logs) {
+      const address = String(log.address).toLowerCase()
+      if (log.topics[0] !== TRANSFER_TOPIC) continue
+      const parsed = this.safeParse(erc20Iface, log as unknown as ethers.Log)
+      if (!parsed) continue
+      const from = String(parsed.args.from).toLowerCase()
+      const to = String(parsed.args.to).toLowerCase()
+      const value = BigInt(parsed.args.value.toString())
+      if (value <= 0n) continue
+
+      if (
+        address === this.mgro &&
+        to !== ZERO_ADDRESS &&
+        classifyMgroTransfer(from, to) === 'mgro_burn'
+      ) {
+        // MGRO rail: the funder's burn is the payment. The log scan stores
+        // the burn row; here we only attach the planting it retired.
+        burnStamps.push({
+          updateOne: {
+            filter: { txHash: receipt.hash.toLowerCase(), logIndex: log.index },
+            update: {
+              $set: {
+                'meta.submissionId': submissionId,
+                'meta.role': 'funder',
+                ...(typeof distribution.grossUsd === 'number'
+                  ? { 'meta.grossUsd': distribution.grossUsd }
+                  : {}),
+              },
+            },
+          },
+        })
+        continue
+      }
+      if (address === this.mgro) continue
+      const role = payoutRoleFor(to, distribution)
+      if (!role) continue
+      rows.push({
+        chainId: this.chainId,
+        txHash: receipt.hash.toLowerCase(),
+        logIndex: log.index,
+        blockNumber: receipt.blockNumber,
+        blockTime,
+        contract: address,
+        kind: 'tgn_payout',
+        token: this.tgnAddresses.has(address) ? 'TGN' : 'ERC20',
+        from,
+        to,
+        amountWei: value.toString(),
+        meta: {
+          submissionId,
+          role,
+          ...(typeof distribution.grossUsd === 'number'
+            ? { grossUsd: distribution.grossUsd }
+            : {}),
+        },
+      })
+    }
+
+    await this.upsertRows(rows)
+    if (burnStamps.length) {
+      await OnchainEvent.bulkWrite(burnStamps, { ordered: false })
+    }
+    return rows.length
+  }
+}
