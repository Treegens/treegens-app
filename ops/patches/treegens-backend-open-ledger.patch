diff --git a/src/services/treasury/mercuryClient.ts b/src/services/treasury/mercuryClient.ts
new file mode 100644
index 0000000..0be8062
--- /dev/null
+++ b/src/services/treasury/mercuryClient.ts
@@ -0,0 +1,186 @@
+import type { MercurySendMode } from './treasuryMath'
+
+/** Injected in tests; defaults to the global fetch (Node ≥ 18). */
+export type FetchLike = (input: string, init?: RequestInit) => Promise<Response>
+
+export interface MercuryTransaction {
+  id: string
+  /** Dollars; positive for credits, negative for debits. */
+  amount: number
+  status: 'pending' | 'sent' | 'cancelled' | 'failed' | string
+  kind?: string
+  counterpartyId?: string | null
+  counterpartyName?: string | null
+  createdAt?: string
+  postedAt?: string | null
+  estimatedDeliveryDate?: string | null
+  failedAt?: string | null
+  reasonForFailure?: string | null
+  note?: string | null
+  externalMemo?: string | null
+  bankDescription?: string | null
+  dashboardLink?: string
+}
+
+export interface MercurySendMoneyInput {
+  recipientId: string
+  /** Dollars with at most two decimals. */
+  amount: number
+  paymentMethod?: 'ach'
+  idempotencyKey: string
+  note?: string
+  externalMemo?: string
+}
+
+export class MercuryApiError extends Error {
+  constructor(
+    readonly status: number,
+    message: string,
+    readonly body?: unknown,
+  ) {
+    super(message)
+  }
+}
+
+const encode = (s: string) => encodeURIComponent(String(s))
+
+/**
+ * Mercury (mercury.com) REST API, the parts the pipeline needs:
+ * read an account's transactions, read one back, list recipients, and send
+ * an ACH payment to a saved recipient.
+ *
+ * The token never appears in an error message or a log line.
+ */
+export class MercuryClient {
+  private readonly fetchImpl: FetchLike
+
+  constructor(
+    private readonly opts: {
+      apiBase: string
+      token: string
+      fetchImpl?: FetchLike
+      timeoutMs?: number
+    },
+  ) {
+    this.fetchImpl = opts.fetchImpl || ((input, init) => fetch(input, init))
+  }
+
+  get configured(): boolean {
+    return Boolean(this.opts.token && this.opts.apiBase)
+  }
+
+  listAccounts(): Promise<{ accounts: any[] }> {
+    return this.request('GET', '/accounts')
+  }
+
+  listRecipients(): Promise<{ recipients: any[] }> {
+    return this.request('GET', '/recipients')
+  }
+
+  listTransactions(
+    accountId: string,
+    q: {
+      start?: string
+      end?: string
+      status?: string
+      limit?: number
+      offset?: number
+    } = {},
+  ): Promise<{ total: number; transactions: MercuryTransaction[] }> {
+    const params = new URLSearchParams()
+    params.set('limit', String(Math.min(500, Math.max(1, q.limit ?? 500))))
+    params.set('offset', String(Math.max(0, q.offset ?? 0)))
+    if (q.start) params.set('start', q.start)
+    if (q.end) params.set('end', q.end)
+    if (q.status) params.set('status', q.status)
+    return this.request(
+      'GET',
+      `/account/${encode(accountId)}/transactions?${params.toString()}`,
+    )
+  }
+
+  /** Every page, oldest page first as Mercury returns them; bounded by `maxPages`. */
+  async listAllTransactions(
+    accountId: string,
+    q: { start?: string; end?: string; status?: string } = {},
+    maxPages = 20,
+  ): Promise<MercuryTransaction[]> {
+    const out: MercuryTransaction[] = []
+    const limit = 500
+    let offset = 0
+    for (let page = 0; page < maxPages; page++) {
+      const r = await this.listTransactions(accountId, { ...q, limit, offset })
+      const rows = r?.transactions || []
+      out.push(...rows)
+      if (rows.length < limit) break
+      offset += rows.length
+    }
+    return out
+  }
+
+  getTransaction(accountId: string, txId: string): Promise<MercuryTransaction> {
+    return this.request(
+      'GET',
+      `/account/${encode(accountId)}/transaction/${encode(txId)}`,
+    )
+  }
+
+  /**
+   * Send USD to a saved recipient.
+   *   direct   POST /account/{id}/transactions (needs a token allowed to
+   *            send money; Mercury may still require in-app approval)
+   *   request  POST /account/{id}/request-send-money (queues it for approval
+   *            in the Mercury dashboard)
+   */
+  sendMoney(
+    accountId: string,
+    input: MercurySendMoneyInput,
+    mode: MercurySendMode = 'direct',
+  ): Promise<MercuryTransaction> {
+    const path =
+      mode === 'request'
+        ? `/account/${encode(accountId)}/request-send-money`
+        : `/account/${encode(accountId)}/transactions`
+    return this.request('POST', path, { paymentMethod: 'ach', ...input })
+  }
+
+  private async request<T = any>(
+    method: 'GET' | 'POST',
+    path: string,
+    body?: unknown,
+  ): Promise<T> {
+    const url = this.opts.apiBase.replace(/\/+$/, '') + path
+    const headers: Record<string, string> = {
+      Authorization: `Bearer ${this.opts.token}`,
+      Accept: 'application/json',
+    }
+    if (body !== undefined) headers['Content-Type'] = 'application/json'
+    const res = await this.fetchImpl(url, {
+      method,
+      headers,
+      body: body === undefined ? undefined : JSON.stringify(body),
+      signal: AbortSignal.timeout(this.opts.timeoutMs ?? 30_000),
+    })
+    const text = await res.text()
+    let json: any = null
+    try {
+      json = text ? JSON.parse(text) : null
+    } catch {
+      json = null
+    }
+    if (!res.ok) {
+      const detail =
+        json?.errors?.message ||
+        json?.message ||
+        json?.error ||
+        text.slice(0, 200) ||
+        `HTTP ${res.status}`
+      throw new MercuryApiError(
+        res.status,
+        `Mercury ${method} ${path.split('?')[0]} → ${res.status}: ${detail}`,
+        json ?? text,
+      )
+    }
+    return json as T
+  }
+}
diff --git a/src/services/treasury/stripeMoneyClient.test.ts b/src/services/treasury/stripeMoneyClient.test.ts
new file mode 100644
index 0000000..b3c9c64
--- /dev/null
+++ b/src/services/treasury/stripeMoneyClient.test.ts
@@ -0,0 +1,159 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { StripeApiError, StripeMoneyClient } from './stripeMoneyClient'
+
+type Call = { url: string; init?: RequestInit }
+
+function fakeFetch(
+  handler: (
+    url: string,
+    init: RequestInit | undefined,
+    n: number,
+  ) => { status?: number; body?: unknown },
+) {
+  const calls: Call[] = []
+  const fetchImpl = async (url: string, init?: RequestInit) => {
+    calls.push({ url, init })
+    const r = handler(url, init, calls.length)
+    return new Response(JSON.stringify(r.body ?? {}), {
+      status: r.status ?? 200,
+      headers: { 'content-type': 'application/json' },
+    })
+  }
+  return { calls, fetchImpl }
+}
+
+const headerOf = (init: RequestInit | undefined, name: string) =>
+  (init?.headers as Record<string, string>)[name]
+
+const input = {
+  financialAccount: 'fa_1',
+  fromCurrency: 'usd',
+  payoutMethod: 'cwa_1',
+  toCurrency: 'usdc',
+  amountMinor: 25_000,
+  amountCurrency: 'usd',
+  description: 'Treegens donation x',
+  idempotencyKey: 'tg-donation-x-onramp',
+}
+
+test('requests carry basic auth, the preview version and the idempotency key', async () => {
+  const { calls, fetchImpl } = fakeFetch(() => ({
+    body: { id: 'obp_1', status: 'processing' },
+  }))
+  const client = new StripeMoneyClient({ secretKey: 'sk_test_abc', fetchImpl })
+  const op = await client.createOutboundPayment(input)
+  assert.equal(op.id, 'obp_1')
+  assert.equal(calls.length, 1)
+  assert.equal(
+    calls[0].url,
+    'https://api.stripe.com/v2/money_management/outbound_payments',
+  )
+  assert.equal(
+    headerOf(calls[0].init, 'Authorization'),
+    'Basic ' + Buffer.from('sk_test_abc:').toString('base64'),
+  )
+  assert.equal(headerOf(calls[0].init, 'Stripe-Version'), '2025-11-17.preview')
+  assert.equal(
+    headerOf(calls[0].init, 'Idempotency-Key'),
+    'tg-donation-x-onramp',
+  )
+  assert.deepEqual(JSON.parse(String(calls[0].init?.body)), {
+    from: { financial_account: 'fa_1', currency: 'usd' },
+    to: { payout_method: 'cwa_1', currency: 'usdc' },
+    amount: { value: 25_000, currency: 'usd' },
+    description: 'Treegens donation x',
+  })
+})
+
+test('a cross-currency send that needs a quote gets one and is retried with it', async () => {
+  const { calls, fetchImpl } = fakeFetch((url, _init, n) => {
+    if (n === 1)
+      return {
+        status: 400,
+        body: {
+          error: {
+            type: 'invalid_request_error',
+            code: 'outbound_payment_quote_required',
+            message:
+              'An OutboundPaymentQuote is required for this currency pair',
+          },
+        },
+      }
+    if (url.endsWith('/outbound_payment_quotes'))
+      return { body: { id: 'opq_9', to_amount: { value: 24_900 } } }
+    return { body: { id: 'obp_2', status: 'processing' } }
+  })
+  const client = new StripeMoneyClient({ secretKey: 'sk', fetchImpl })
+  const op = await client.createOutboundPayment(input)
+  assert.equal(op.id, 'obp_2')
+  assert.equal(calls.length, 3)
+  assert.match(calls[1].url, /outbound_payment_quotes$/)
+  assert.equal(
+    headerOf(calls[1].init, 'Idempotency-Key'),
+    'tg-donation-x-onramp-quote',
+  )
+  const retry = JSON.parse(String(calls[2].init?.body))
+  assert.equal(retry.outbound_payment_quote, 'opq_9')
+  assert.equal(
+    headerOf(calls[2].init, 'Idempotency-Key'),
+    'tg-donation-x-onramp-q',
+  )
+})
+
+test('other errors surface as StripeApiError with code and status', async () => {
+  const { fetchImpl } = fakeFetch(() => ({
+    status: 402,
+    body: {
+      error: { code: 'insufficient_funds', message: 'Not enough USD' },
+    },
+  }))
+  const client = new StripeMoneyClient({ secretKey: 'sk', fetchImpl })
+  await assert.rejects(
+    client.createOutboundPayment(input),
+    (error: unknown) => {
+      assert.ok(error instanceof StripeApiError)
+      assert.equal(error.status, 402)
+      assert.equal(error.code, 'insufficient_funds')
+      assert.match(error.message, /Not enough USD/)
+      return true
+    },
+  )
+})
+
+test('balances and payout-method wallets are read from whichever shape the API uses', () => {
+  const fa = {
+    balance: { available: { usd: { value: 12_345, currency: 'usd' } } },
+  }
+  assert.equal(StripeMoneyClient.availableMinor(fa, 'usd'), 12_345)
+  assert.equal(StripeMoneyClient.availableMinor(fa, 'usdc'), 0)
+  assert.equal(StripeMoneyClient.availableMinor(null, 'usd'), 0)
+  assert.deepEqual(
+    StripeMoneyClient.cryptoWalletOf({
+      crypto_wallet: { address: '0xabc', network: 'Base' },
+    }),
+    { address: '0xabc', network: 'base' },
+  )
+  assert.deepEqual(
+    StripeMoneyClient.cryptoWalletOf({
+      usd_crypto_wallet: { address: '0xdef' },
+    }),
+    { address: '0xdef', network: 'base' },
+  )
+  assert.equal(StripeMoneyClient.cryptoWalletOf({ bank_account: {} }), null)
+})
+
+test('financial addresses ask for the account and routing numbers of the configured account', async () => {
+  const { calls, fetchImpl } = fakeFetch(() => ({ body: { data: [] } }))
+  const client = new StripeMoneyClient({ secretKey: 'sk', fetchImpl })
+  await client.listFinancialAddresses('fa_1')
+  const url = new URL(calls[0].url)
+  assert.equal(url.pathname, '/v2/money_management/financial_addresses')
+  assert.equal(url.searchParams.get('financial_account'), 'fa_1')
+  assert.deepEqual(url.searchParams.getAll('include'), [
+    'credentials.us_bank_account.account_number',
+    'credentials.us_bank_account.routing_number',
+  ])
+  assert.equal(calls[0].init?.method, 'GET')
+  assert.equal(headerOf(calls[0].init, 'Idempotency-Key'), undefined)
+})
diff --git a/src/services/treasury/stripeMoneyClient.ts b/src/services/treasury/stripeMoneyClient.ts
new file mode 100644
index 0000000..0c5689e
--- /dev/null
+++ b/src/services/treasury/stripeMoneyClient.ts
@@ -0,0 +1,221 @@
+import type { FetchLike } from './mercuryClient'
+
+export const STRIPE_API_BASE = 'https://api.stripe.com'
+/** The preview version world.treegens.app's treasury cron already runs on. */
+export const STRIPE_MONEY_MANAGEMENT_VERSION = '2025-11-17.preview'
+
+export class StripeApiError extends Error {
+  constructor(
+    readonly status: number,
+    message: string,
+    readonly code: string,
+    readonly body?: unknown,
+  ) {
+    super(message)
+  }
+}
+
+export interface OutboundPaymentInput {
+  financialAccount: string
+  /** Balance currency the money leaves in, e.g. 'usd'. */
+  fromCurrency: string
+  /** A crypto-wallet payout method (`cwa_…`) registered in the Stripe Dashboard. */
+  payoutMethod: string
+  /** What the recipient receives, e.g. 'usdc'. */
+  toCurrency: string
+  /** Minor units of `amountCurrency` (cents). */
+  amountMinor: number
+  amountCurrency: string
+  description: string
+  idempotencyKey: string
+  /** Set when Stripe asked for a quote first (cross-currency sends). */
+  quoteId?: string
+}
+
+/**
+ * Stripe Money Management (v2): the USD financial account and outbound
+ * payments to a crypto-wallet payout method, which is how USD becomes USDC
+ * on Base. Same calls and API version as world.treegens.app's treasury cron.
+ */
+export class StripeMoneyClient {
+  private readonly fetchImpl: FetchLike
+  private readonly apiBase: string
+  private readonly apiVersion: string
+
+  constructor(
+    private readonly opts: {
+      secretKey: string
+      apiVersion?: string
+      apiBase?: string
+      fetchImpl?: FetchLike
+      timeoutMs?: number
+    },
+  ) {
+    this.fetchImpl = opts.fetchImpl || ((input, init) => fetch(input, init))
+    this.apiBase = (opts.apiBase || STRIPE_API_BASE).replace(/\/+$/, '')
+    this.apiVersion = opts.apiVersion || STRIPE_MONEY_MANAGEMENT_VERSION
+  }
+
+  get configured(): boolean {
+    return Boolean(this.opts.secretKey)
+  }
+
+  getFinancialAccount(id: string): Promise<any> {
+    return this.request(
+      'GET',
+      `/v2/money_management/financial_accounts/${encodeURIComponent(id)}`,
+    )
+  }
+
+  listFinancialAccounts(): Promise<{ data: any[] }> {
+    return this.request('GET', '/v2/money_management/financial_accounts')
+  }
+
+  /** The bank details (routing + account number) a Mercury recipient is saved from. */
+  listFinancialAddresses(financialAccount: string): Promise<{ data: any[] }> {
+    const params = new URLSearchParams()
+    params.set('financial_account', financialAccount)
+    params.append('include', 'credentials.us_bank_account.account_number')
+    params.append('include', 'credentials.us_bank_account.routing_number')
+    return this.request(
+      'GET',
+      `/v2/money_management/financial_addresses?${params.toString()}`,
+    )
+  }
+
+  listPayoutMethods(): Promise<{ data: any[] }> {
+    return this.request('GET', '/v2/money_management/payout_methods')
+  }
+
+  getPayoutMethod(id: string): Promise<any> {
+    return this.request(
+      'GET',
+      `/v2/money_management/payout_methods/${encodeURIComponent(id)}`,
+    )
+  }
+
+  createOutboundPaymentQuote(input: OutboundPaymentInput): Promise<any> {
+    return this.request(
+      'POST',
+      '/v2/money_management/outbound_payment_quotes',
+      StripeMoneyClient.paymentBody(input),
+      `${input.idempotencyKey}-quote`,
+    )
+  }
+
+  /**
+   * USD out of the financial account, USDC into the treasury wallet.
+   * If Stripe answers that a cross-currency send needs a quote, one is
+   * created and the payment is retried with it (a new idempotency key: the
+   * body changed).
+   */
+  async createOutboundPayment(input: OutboundPaymentInput): Promise<any> {
+    try {
+      return await this.request(
+        'POST',
+        '/v2/money_management/outbound_payments',
+        StripeMoneyClient.paymentBody(input),
+        input.idempotencyKey,
+      )
+    } catch (error) {
+      if (
+        error instanceof StripeApiError &&
+        !input.quoteId &&
+        /quote/i.test(`${error.code} ${error.message}`)
+      ) {
+        const quote = await this.createOutboundPaymentQuote(input)
+        if (!quote?.id) throw error
+        return this.createOutboundPayment({
+          ...input,
+          quoteId: quote.id,
+          idempotencyKey: `${input.idempotencyKey}-q`,
+        })
+      }
+      throw error
+    }
+  }
+
+  getOutboundPayment(id: string): Promise<any> {
+    return this.request(
+      'GET',
+      `/v2/money_management/outbound_payments/${encodeURIComponent(id)}`,
+    )
+  }
+
+  static paymentBody(input: OutboundPaymentInput) {
+    return {
+      from: {
+        financial_account: input.financialAccount,
+        currency: input.fromCurrency,
+      },
+      to: { payout_method: input.payoutMethod, currency: input.toCurrency },
+      amount: { value: input.amountMinor, currency: input.amountCurrency },
+      description: input.description,
+      ...(input.quoteId ? { outbound_payment_quote: input.quoteId } : {}),
+    }
+  }
+
+  /** Available balance of a financial account in minor units of `currency`. */
+  static availableMinor(financialAccount: any, currency: string): number {
+    const v = financialAccount?.balance?.available?.[currency]?.value
+    const n = Number(v ?? 0)
+    return Number.isFinite(n) ? n : 0
+  }
+
+  /** The wallet a crypto payout method pays, whichever field the API version uses. */
+  static cryptoWalletOf(
+    payoutMethod: any,
+  ): { address: string; network: string } | null {
+    const w =
+      payoutMethod?.crypto_wallet ||
+      payoutMethod?.usd_crypto_wallet ||
+      payoutMethod?.usdc_crypto_wallet ||
+      null
+    if (!w?.address) return null
+    return {
+      address: String(w.address),
+      network: String(w.network || 'base').toLowerCase(),
+    }
+  }
+
+  private async request<T = any>(
+    method: 'GET' | 'POST',
+    path: string,
+    body?: unknown,
+    idempotencyKey?: string,
+  ): Promise<T> {
+    const headers: Record<string, string> = {
+      Authorization:
+        'Basic ' + Buffer.from(`${this.opts.secretKey}:`).toString('base64'),
+      'Stripe-Version': this.apiVersion,
+      Accept: 'application/json',
+    }
+    if (body !== undefined) headers['Content-Type'] = 'application/json'
+    if (idempotencyKey) headers['Idempotency-Key'] = idempotencyKey
+    const res = await this.fetchImpl(this.apiBase + path, {
+      method,
+      headers,
+      body: body === undefined ? undefined : JSON.stringify(body),
+      signal: AbortSignal.timeout(this.opts.timeoutMs ?? 30_000),
+    })
+    const text = await res.text()
+    let json: any = null
+    try {
+      json = text ? JSON.parse(text) : null
+    } catch {
+      json = null
+    }
+    if (!res.ok) {
+      const err = json?.error || {}
+      const code = String(err.code || err.type || '')
+      const detail = err.message || text.slice(0, 200) || `HTTP ${res.status}`
+      throw new StripeApiError(
+        res.status,
+        `Stripe ${method} ${path.split('?')[0]} → ${res.status}: ${detail}`,
+        code,
+        json ?? text,
+      )
+    }
+    return json as T
+  }
+}
