+
+test('cursor round-trips and afterCursor skips everything up to the cursor item', () => {
+  const items = [
+    { at: '2026-01-03T00:00:00.000Z', id: 'x:3' },
+    { at: '2026-01-02T00:00:00.000Z', id: 'x:2b' },
