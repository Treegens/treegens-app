+  )
+  assert.equal(labelAddress(known.verifierMinter, known), 'Minter contract')
+  assert.equal(
+    labelAddress(known.retirements[0], known),
+    'Mangrove retirement contract',
+  )
+  assert.equal(labelAddress(DEAD_ADDRESS, known), 'Burn address (0x…dEaD)')
+  assert.equal(labelAddress(A, known, { planters: new Set([A]) }), 'Planter')
+  assert.equal(labelAddress(A, known, { buyers: new Set([A]) }), 'Buyer (OTC)')
+  assert.equal(labelAddress(A, known, { verifiers: new Set([A]) }), 'Verifier')
+  assert.equal(labelAddress(A, known), 'Wallet')
+})
+
+test('isMangrove accepts both spellings and publicGps rounds', () => {
+  assert.equal(isMangrove('Mangrove'), true)
+  assert.equal(isMangrove('mangroves'), true)
+  assert.equal(isMangrove('acacia'), false)
+  assert.deepEqual(
+    publicGps({ latitude: -4.123456789, longitude: 39.98765432 }),
+    { lat: -4.1235, lng: 39.9877 },
+  )
+  assert.equal(publicGps(null), null)
+})
+
+test('decimalToWeiString handles plain, scientific and Decimal128-like values', () => {
+  assert.equal(decimalToWeiString('123'), '123')
+  assert.equal(decimalToWeiString('1.5E+21'), '1500000000000000000000')
+  assert.equal(decimalToWeiString('1E+21'), '1000000000000000000000')
+  assert.equal(
+    decimalToWeiString({ toString: () => '95000000000000000000' }),
+    '95000000000000000000',
+  )
+  assert.equal(decimalToWeiString('0.5'), '0')
+  assert.equal(decimalToWeiString(null), '0')
+  assert.equal(decimalToWeiString('garbage'), '0')
+})
+
+test('parseEvidenceURI reads every evidence form the minters have carried', () => {
+  assert.deepEqual(parseEvidenceURI(`treegens://submission/${SID}/tranche/2`), {
+    submissionId: SID,
+    role: 'planter',
+    trancheIndex: 2,
+  })
+  assert.deepEqual(
+    parseEvidenceURI(
+      `treegens://submission/${SID.toUpperCase()}/planter/tranche/0`,
+    ),
+    { submissionId: SID, role: 'planter', trancheIndex: 0 },
+  )
+  assert.deepEqual(
+    parseEvidenceURI(`treegens://submission/${SID}/verifier/${A}`),
+    {
+      submissionId: SID,
+      role: 'verifier',
+      wallet: A,
+    },
+  )
+  assert.deepEqual(parseEvidenceURI(`treegens://submission/${SID}`), {
+    submissionId: SID,
+    role: 'planter',
+  })
+  assert.deepEqual(parseEvidenceURI(`treegens://verifier-payout/${A}/abcdef`), {
+    role: 'verifier',
+    wallet: A,
+  })
+  assert.deepEqual(
+    parseEvidenceURI(
+      `https://world.treegens.app/.netlify/functions/video-meta?src=treegensapp&id=${SID}`,
+    ),
+    { submissionId: SID, role: 'unknown' },
+  )
+  assert.equal(parseEvidenceURI('treegens://reward/0xabc/1000'), null)
+  assert.equal(parseEvidenceURI(''), null)
+})
+
+test('parseSubmissionIdFromUrl finds ids in query strings, stitched names and path segments', () => {
+  assert.equal(parseSubmissionIdFromUrl(`https://x/y?src=a&id=${SID}`), SID)
+  assert.equal(
+    parseSubmissionIdFromUrl(
+      `https://storage.googleapis.com/b/verified-${SID}-1700000000.mp4`,
+    ),
+    SID,
+  )
+  assert.equal(parseSubmissionIdFromUrl(`https://x/${SID}/plant.mp4`), SID)
+  assert.equal(parseSubmissionIdFromUrl('https://x/nothing-here.mp4'), null)
+})
+
+test('classifyMgroTransfer separates mints, burns (0x0 and dEaD) and plain transfers', () => {
+  assert.equal(classifyMgroTransfer(ZERO_ADDRESS, A), 'mgro_mint')
+  assert.equal(classifyMgroTransfer(A, ZERO_ADDRESS), 'mgro_burn')
+  assert.equal(classifyMgroTransfer(A, DEAD_ADDRESS), 'mgro_burn')
+  assert.equal(classifyMgroTransfer(A, B), null)
+  assert.equal(classifyMgroTransfer(ZERO_ADDRESS, DEAD_ADDRESS), null)
+})
+
+test('payoutRoleFor and isRangeTooLargeError', () => {
+  const d = { planterWallet: A, verifiers: [{ wallet: B.toUpperCase() }] }
+  assert.equal(payoutRoleFor(A.toUpperCase(), d), 'planter')
+  assert.equal(payoutRoleFor(B, d), 'verifier')
+  assert.equal(
+    payoutRoleFor('0xcccccccccccccccccccccccccccccccccccccccc', d),
+    null,
+  )
+  assert.equal(
+    isRangeTooLargeError(new Error('query returned more than 10000 results')),
+    true,
+  )
+  assert.equal(
+    isRangeTooLargeError({ message: 'block range is too wide' }),
+    true,
+  )
+  assert.equal(isRangeTooLargeError(new Error('execution reverted')), false)
+})
