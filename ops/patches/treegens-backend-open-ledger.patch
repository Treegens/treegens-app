+TREASURY_PIPELINE_MODE=dry_run
+# TREASURY_POLL_MS=300000
+# TREASURY_REQUIRE_APPROVAL=false        # true: every new donation waits for a release
+# TREASURY_LOOKBACK_DAYS=30
+# TREASURY_MIN_DONATION_USD=1
+# TREASURY_DONATION_KINDS=externalTransfer,incomingDomesticWire,incomingInternationalWire,checkDeposit
+# TREASURY_SWEEP_RESERVE_PCT=0           # share of each donation that stays at the bank
+# TREASURY_MAX_SWEEP_USD=10000           # most USD one Mercury payment moves
