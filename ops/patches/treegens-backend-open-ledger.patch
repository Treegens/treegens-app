+
+/** `$toDecimal` throws on a malformed string; only ever feed it digits. */
+function safeDecimal(field: string) {
+  return {
+    $toDecimal: {
+      $cond: [
+        {
+          $regexMatch: {
+            input: { $toString: { $ifNull: [field, '0'] } },
+            regex: /^[0-9]+$/,
+          },
+        },
+        { $toString: { $ifNull: [field, '0'] } },
+        '0',
+      ],
+    },
+  }
+}
