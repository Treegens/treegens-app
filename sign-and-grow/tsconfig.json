{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-verify-twostep/types/**/*.ts",
    ".next-verify-twostep/dev/types/**/*.ts",
    ".next-verify-qr-encrypt/types/**/*.ts",
    ".next-verify-qr-encrypt/dev/types/**/*.ts",
    ".next-verify-comments/types/**/*.ts",
    ".next-verify-comments/dev/types/**/*.ts",
    ".next-repair-signercode/types/**/*.ts",
    ".next-repair-signercode/dev/types/**/*.ts",
    ".next-repair-misc-today/types/**/*.ts",
    ".next-repair-misc-today/dev/types/**/*.ts",
    ".next-verify-pay-round4/types/**/*.ts",
    ".next-verify-pay-round4/dev/types/**/*.ts",
    ".next-repair-mobile/types/**/*.ts",
    ".next-repair-mobile/dev/types/**/*.ts",
    ".next-build-chat/types/**/*.ts",
    ".next-build-chat/dev/types/**/*.ts",
    ".next-build-ds-sec-log/types/**/*.ts",
    ".next-build-ds-sec-log/dev/types/**/*.ts",
    ".next-build-brand-wire/types/**/*.ts",
    ".next-build-brand-wire/dev/types/**/*.ts",
    ".next-build-simplify-start/types/**/*.ts",
    ".next-build-simplify-start/dev/types/**/*.ts",
    ".next-dragdrop/types/**/*.ts",
    ".next-dragdrop/dev/types/**/*.ts",
    ".next-vop/types/**/*.ts",
    ".next-vop/dev/types/**/*.ts",
    ".next-build-ds-page-tools/types/**/*.ts",
    ".next-build-ds-page-tools/dev/types/**/*.ts",
    ".next-build-ds-templates-lib/types/**/*.ts",
    ".next-build-ds-templates-lib/dev/types/**/*.ts",
    ".next-uxdstpl/types/**/*.ts",
    ".next-uxdstpl/dev/types/**/*.ts",
    ".next-build-ds-a11y/types/**/*.ts",
    ".next-build-ds-a11y/dev/types/**/*.ts",
    ".next-repair-ds-seal-ltv/types/**/*.ts",
    ".next-repair-ds-seal-ltv/dev/types/**/*.ts",
    ".next-ux-ds-fields-checks/types/**/*.ts",
    ".next-ux-ds-fields-checks/dev/types/**/*.ts",
    ".next-uxdsa11y/types/**/*.ts",
    ".next-uxdsa11y/dev/types/**/*.ts",
    ".next-build-write-contract/types/**/*.ts",
    ".next-build-write-contract/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
