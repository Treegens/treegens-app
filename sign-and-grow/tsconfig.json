{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-verify-twostep/types/**/*.ts",
    ".next-verify-twostep/dev/types/**/*.ts",
    ".next-verify-qr-encrypt/types/**/*.ts",
    ".next-verify-qr-encrypt/dev/types/**/*.ts",
    ".next-verify-comments/types/**/*.ts",
    ".next-verify-comments/dev/types/**/*.ts",
    ".next-repair-signercode/types/**/*.ts",
    ".next-repair-signercode/dev/types/**/*.ts",
    ".next-repair-misc-today/types/**/*.ts",
    ".next-repair-misc-today/dev/types/**/*.ts",
    ".next-verify-pay-round4/types/**/*.ts",
    ".next-verify-pay-round4/dev/types/**/*.ts",
    ".next-repair-mobile/types/**/*.ts",
    ".next-repair-mobile/dev/types/**/*.ts",
    ".next-repair-comments/types/**/*.ts",
    ".next-repair-comments/dev/types/**/*.ts",
    ".next-repair-groups/types/**/*.ts",
    ".next-repair-groups/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
