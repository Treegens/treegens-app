# Public address of the app. REQUIRED on a real deployment: every link in every email is built from it, for
# example APP_URL=https://sign.example.com
# Without it, links are only right when the app runs on your own machine (localhost). The address of a request
# to any other host is not used, because a request header can be forged: links then point at
# http://localhost:3000 and a warning is logged.
APP_URL=http://localhost:3000

# How many proxies of your own sit between the internet and the app (a load balancer, a CDN, the router of a
# hosting platform). The caller's address, used for rate limits and the audit trail, is read that many places
# from the right of X-Forwarded-For, because everything further left is whatever the caller typed. Default 1.
# Set 0 only when nothing is in front of the app: the header is then ignored, the app cannot tell callers apart,
# and every visitor shares one set of rate limits.
# TRUSTED_PROXY_HOPS=1

# Where the SQLite database and uploaded files are stored. Use a persistent disk in production.
# DATA_DIR=./data

# Secret for signing cookies and stop links. If unset, one is generated and kept in DATA_DIR.
# APP_SECRET=

# Encrypts every file the app stores from now on (uploaded documents, signed PDFs, files signers attach) with
# AES-256-GCM. 32 random bytes as base64. Make one with:  openssl rand -base64 32
# (or: node scripts/encrypt-files.mjs --new-key). Keep a copy apart from the server and its backups: without the key
# nobody can read those files, and that includes us. The database is NOT encrypted: names, addresses, what people
# typed and the audit trails stay readable to whoever has the disk, so encrypt the disk as well. Files stored before
# stay readable; "node scripts/encrypt-files.mjs" encrypts them (stop the server first, use the same settings).
# FILE_ENCRYPTION_KEY=
# Changing the key: put the new one in FILE_ENCRYPTION_KEY and the earlier one here (a list, separated by commas),
# restart, then run the script, which moves every file to the new key. Keep an old key listed until the script says
# it is done. A server that finds files it has no key for stores nothing new until that key is listed here.
# FILE_ENCRYPTION_KEYS_OLD=

# Mail. Without SMTP_URL, emails are only shown in /dev/outbox (development only), nothing is delivered, and the
# audit trail of an envelope says "Not emailed" instead of "Sent to recipient". An email the mail server will not
# take is kept and tried again by the timer below: after 5 minutes, 30 minutes, 2 hours, 6 hours and a day.
# A mail server that stops answering is given up on after 10 seconds to connect, 10 for its greeting and 20 of
# silence, and the email is tried again later; add ?connectionTimeout=..&greetingTimeout=..&socketTimeout=..
# (milliseconds) to the address to change that.
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_FROM="Sign&Grow" <sign@example.com>
# What became of an email after the mail server took it: delivered, bounced, marked as spam. Set a secret of at
# least 16 characters (openssl rand -hex 24) and give your mail provider (Postmark, SendGrid, Mailgun, Resend, or
# Amazon SES through SNS) the webhook address https://<your domain>/api/mail/events?token=<the secret>. Senders then
# hear at once when an email to a recipient could not be delivered. Without it that address does not exist. See the
# README, "Knowing when an email did not arrive".
# MAIL_EVENTS_TOKEN=

# Lets an external scheduler run reminders, new tries for emails that did not leave, expiry, nudges and account closing:
# POST /api/cron with "Authorization: Bearer <secret>"
# CRON_SECRET=

# Paying (optional). Without these nothing is counted and there is nothing to buy.
# STRIPE_PRICE_GROVE is the monthly price. It must charge the amount in src/lib/impact.ts.
# Send these events to /api/stripe/webhook: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, invoice.paid, invoice.upcoming, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted, charge.refunded, charge.dispute.created.
# 1 asks business buyers for their tax number (VAT, GST) and billing address on the payment page, for the invoice.
# Try it in test mode first: the provider refuses the request unless its own settings allow it.
# STRIPE_COLLECT_TAX_ID=1
# How long a message from the provider is worked on before it is answered (milliseconds). Longer work is
# finished in the background from an inbox table. Default 5000.
# STRIPE_WEBHOOK_WAIT_MS=5000
# Pin the provider's API version to the one you tested with (and set the webhook endpoint to the same one).
# STRIPE_API_VERSION=
# Card disputes up to this many dollars are accepted with the provider automatically; larger ones wait for a person.
# 0 leaves every dispute to a person. Billing stops either way.
# ACCEPT_DISPUTES_UP_TO_USD=25
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_GROVE=
# STRIPE_WEBHOOK_SECRET=

# Codes that make the monthly plan free for whoever enters one, at sign-up or on the Plan page. Comma separated.
# Default: GROWalition. Set to an empty value to have no codes.
# FREE_PLAN_CODES=GROWalition

# ---- Help, trust and the people who run the service ----------------------------------------------

# The address people can write to. Shown on /help, told about every new help request and every late one, and
# sent the alerts that need a human: an unmatched payment, a card dispute. A help request is answered in the
# operator queue (/app/operator), not by replying to that email. Without this address, new and late requests
# are emailed to OPERATOR_EMAILS instead, and are shown in the operator queue either way.
# When set, it is also printed in the footer of every public page and in the menu of the app. A production
# server that starts without it logs a loud warning, because every page promises that a person answers.
# SUPPORT_EMAIL=help@example.com

# Where reports of suspicious documents go. Default: SUPPORT_EMAIL.
# ABUSE_EMAIL=abuse@example.com

# Who may open /app/operator (help requests, reports, pausing an account). Comma separated. Each address
# must belong to an account whose email is confirmed. Default: nobody.
# OPERATOR_EMAILS=you@example.com,colleague@example.com

# The published response time for help requests, in real hours (nights and weekends count). The help page,
# the confirmation email and every request quote the actual time a person will have answered by. When it
# passes, the request says "We are late" to the customer and the timer emails SUPPORT_EMAIL and every operator.
# Default 24. Urgent requests (cannot log in, charged wrongly, a stuck document or a near deadline) have their
# own, default 8, never longer than the first. With neither SUPPORT_EMAIL nor OPERATOR_EMAILS set, no time is
# promised anywhere.
# SUPPORT_FIRST_REPLY_HOURS=24
# SUPPORT_URGENT_REPLY_HOURS=8

# Days after a payment during which its unused signatures are refunded on request, with no approval. Default 30.
# The help page and the pricing section quote this number.
# REFUND_DAYS=30

# How many people an account that has not paid may send to per day during its first week. Default 50.
# "Has not paid" means: no payment for the plan or a top-up that is at least 14 days old and was neither
# refunded nor disputed (PAID_TRUST_DAYS in src/lib/policy.ts), and not marked as trusted in the operator
# queue. An account that paid yesterday still has the limit. Everyone a sender newly emails counts: a first
# send, a person added or an address changed on an envelope that is out, a bulk row. The visitors of a public
# form are counted apart, against the same number for each form. Team invitations have their own limit of
# 20 people a day for each account.
# NEW_ACCOUNT_DAILY_RECIPIENTS=50

# The same limit after the first week. Default 200. A payment lifts both limits once it has stood for 14
# days, and "Trust this account" in the operator queue lifts them at once. The same holds for the filter
# for fake payment notices. The help and security pages quote both numbers.
# UNPAID_DAILY_RECIPIENTS=200

# How many different recipients must report an account within 30 days before its sending is paused until a
# person has reviewed it. Default 3. Open reports and reports an operator confirmed as abuse both count.
# Reports from visitors of a public form are shown to operators and never count.
# ABUSE_SUSPEND_AFTER=3

# Hours after which an unfinished start from a public form that nobody touched is closed, so it no longer
# counts against what the form can still take. The visitor can simply start again. Default 24.
# POWERFORM_IDLE_HOURS=24
# The same for a public form marked as filled in on a shared device (a front-desk tablet), in minutes.
# POWERFORM_SHARED_IDLE_MINUTES=60

# A paid plan that has sent nothing for this many days is not renewed: the renewal is stopped and the owner is
# told. Default 90. Set to 0 to only send a warning.
# DORMANT_AUTO_STOP_DAYS=90

# Hours a signing request may sit unopened before the sender is told. Default 48.
# UNOPENED_ALERT_HOURS=48

# ---- Signing in with Google or Microsoft (optional) ----------------------------------------------

# "Continue with Google" on the sign-in and sign-up pages and under Settings. Both values must be set. With either
# one missing, nothing about Google is shown anywhere and its routes answer 404.
# Create an OAuth client of the type "Web application" in the Google Cloud console and register this redirect
# address there, exactly: APP_URL + /api/auth/google/callback
# for example https://sign.example.com/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# "Continue with Microsoft". Both values must be set. Register an app in the Microsoft Entra admin centre, add the
# platform "Web" and this redirect address, exactly: APP_URL + /api/auth/microsoft/callback
# for example https://sign.example.com/api/auth/microsoft/callback
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Who may sign in with Microsoft: common (work, school and personal accounts, the default), organizations (work and
# school), consumers (personal), or the id of one organization (its "Directory (tenant) ID"). A domain name is not
# accepted: Microsoft sign-in then stays off and the server log says why.
# MICROSOFT_TENANT=common

# A person is recognised by the provider's own id for them, never by an email address alone. The README says when
# a provider is taken to vouch for an address ("Signing in with Google or Microsoft").

# ---- Where the data is (printed on /security and in the data processing summary) ------------------

# Plain text, printed as written. The page lists a mail provider, a payment provider and a text message provider
# only when they are switched on above, so it cannot name one this server does not use. Whatever you leave empty
# here is printed as "The operator of this server has not said ... Ask them.", never left out, and a production
# server that starts with something missing says so once in its log.
# Who runs this server: legal name and country. A customer who needs a signed data processing agreement signs it
# with them.
# OPERATOR_NAME=Example Trees e.V., Hamburg, Germany
# Where the server and its files are, and the hosting company.
# DATA_REGION=Frankfurt, Germany
# DATA_HOST=Example Hosting GmbH
# Whether and where backups are kept, and for how long. One sentence.
# DATA_BACKUPS=A copy every night, kept for 30 days in Helsinki, Finland.
# The company behind SMTP_URL and the country it handles email in.
# MAIL_PROVIDER_NAME=Example Mail Ltd
# MAIL_PROVIDER_COUNTRY=Ireland
# The country of the Stripe company your payment account is with, as your agreement with Stripe names it.
# PAYMENT_PROVIDER_COUNTRY=
# The text message provider, when texts are switched on. Its name is known when it is Twilio.
# SMS_PROVIDER_NAME=
# SMS_PROVIDER_COUNTRY=

# ---- Text messages (optional) --------------------------------------------------------------------

# Text messages are off until one of the two ways below is set up. While they are off nothing in the product
# offers them: no one-time code by text message, no "also text the signing link", and the API refuses both with a
# sentence that says so. A one-time code by email needs none of this.
#
# (a) Twilio. All of TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN, and one of TWILIO_FROM (a number of yours in
#     international form) or TWILIO_MESSAGING_SERVICE_SID (wins when both are set). Texts are sent with fetch to
#     https://api.twilio.com, no SDK.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550100
# TWILIO_MESSAGING_SERVICE_SID=
#
# (b) Any other provider, through a small hook of your own. Every text is one POST to SMS_WEBHOOK_URL with the
#     JSON body {"to": "+447700900123", "text": "..."} and the header "Authorization: Bearer <SMS_WEBHOOK_TOKEN>".
#     Answer 2xx when you took the text (an "id" in a JSON answer is kept as its reference). Answer 400 or 422 for
#     a number that can never be texted: that is final and the sender is told at once. Any other failure is tried
#     again by the timer, after 5 minutes, 30 minutes, 2 hours, 6 hours and a day.
# SMS_WEBHOOK_URL=https://texts.example.com/send
# SMS_WEBHOOK_TOKEN=
#
# The most text messages one account can cause in 24 hours: codes, links and reminders, every new one counted,
# also a code that is asked for again. A text costs you money and customers are not charged for it, so this is a
# hard stop with a clear message. Default 200. 0 lets none through.
# SMS_DAILY_PER_ACCOUNT=200

# ---- Development only ----------------------------------------------------------------------------

# Switch text messages on without a provider: every text is only written to the outbox (/dev/outbox), where you
# can read the code or follow the link. Ignored on a production server unless DEV_OUTBOX=1 is set as well, because
# it delivers nothing to anyone.
# SMS_DEV_OUTBOX=1

# Accept webhook addresses that are not public https, for testing against localhost.
# ALLOW_PRIVATE_WEBHOOKS=1

# Show the outbox in a production build. Never set this on a public server: it exposes every signing link.
# DEV_OUTBOX=1
