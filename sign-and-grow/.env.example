# Public address of the app, used for links in emails.
APP_URL=http://localhost:3000

# Where the SQLite database and uploaded files are stored. Use a persistent disk in production.
# DATA_DIR=./data

# Secret for signing cookies. If unset, one is generated and kept in DATA_DIR.
# APP_SECRET=

# Mail. Without SMTP_URL, emails are only shown in /dev/outbox (development only).
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_FROM="Sign&Grow" <sign@example.com>

# Lets an external scheduler trigger reminders and expiry: POST /api/cron with "Authorization: Bearer <secret>"
# CRON_SECRET=

# Billing (optional). Without these there are no sending limits and nothing to pay.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_GROVE=
# STRIPE_WEBHOOK_SECRET=

# If set, the impact page also shows roughly how many trees the revenue has funded.
# TREE_COST_USD=
