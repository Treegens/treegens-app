+import fs from 'fs'
+import mongoose from 'mongoose'
+import { v4 as uuidv4 } from 'uuid'
+import {
+  deleteFromGcs,
+  isGcsConfigured,
+  uploadGwrClipToGcs,
+} from '../config/gcs'
+import TrackClip from '../models/TrackClip'
+import { isMangroveTreeType } from '../utils/effectiveTreeCount'
+import { chooseFilmedAt, mp4CreationTime } from '../utils/mp4CreationTime'
+import { UploadRefusedError } from '../utils/uploadRouteErrors'
+import {
+  initialAiFields,
+  type ClipAiTarget,
+  gwrAiEnabled,
+} from './gwrAiCountService'
+import {
+  csvCell,
+  gwrFileExtension,
+  gwrMimeForExtension,
+  slugify,
+  utcStamp,
+} from './gwrVideoNaming'
+import { md5OfFile } from './gwrVideoService'
+
+/**
+ * treegens.app/track: the planting app's filming and counting, with no
+ * crypto. A phone films the land clip and the plant clip of each tree on
+ * the same screen as a planting and sends them through the same resumable
+ * upload sessions (uploadSessionService, mounted at /api/track/uploads); a
+ * session of the 'track' channel is stored here instead of as a Submission.
+ *
+ * Nothing here reads or writes submissions, users, verifiers, rewards, OTC
+ * or MGRO. The trees are public: anyone with the link sees the dashboard.
+ *
+ * The count of a tree is the planting app's rule: the planter's own number,
+ * or for mangroves the AI count of the plant clip, made by the same
+ * background sweep that counts the GWR clips (gwrAiCountService).
+ */
+
+export const TRACK_STORAGE_PREFIX = 'track/'
+const TRACK_AI_PREFIX = `${TRACK_STORAGE_PREFIX}ai/`
+/** Session wallets of the track channel start with this. */
+export const TRACK_DEVICE_PREFIX = 'track:'
+
+/** The AI sweeps' view of the track clips: mangrove plant clips only. */
+export const TRACK_AI_TARGET: ClipAiTarget = {
+  model: TrackClip,
+  scope: { aiEligible: true },
+  objectPrefix: TRACK_AI_PREFIX,
+  namePrefix: 'track-ai',
+  overlayName: name =>
+    `${name.replace(/\.[a-z0-9]{2,5}$/i, '').replace(/-after$/, '')}-ai.mp4`,
+  tag: 'trackAi',
+}
+
+export const isTrackDevice = (wallet: string | undefined | null) =>
+  typeof wallet === 'string' && wallet.startsWith(TRACK_DEVICE_PREFIX)
+
+/** What the session hands over for one clip. */
+export interface TrackClipInput {
+  uploadId: string
+  device: string
+  kind: 'land' | 'plant'
+  /** Plant: the tree's id (its land clip's _id), resolved by the session. */
+  treeId?: string
+  clientGroupId?: string
+  planterName?: string
+  latitude?: number
+  longitude?: number
+  gpsAccuracy?: number
+  gpsEnd?: string
+  gpsPath?: string
+  reverseGeocode?: string
+  treesPlanted?: number
+  treeType?: string
+  recordedAt?: Date
+}
+
+export interface TrackStoredFile {
+  path: string
+  originalname: string
+  mimetype: string
+  size: number
+}
+
+/** What the phone's upload queue reads back: the planting route's shape,
+ * with the tree's id where a planting's would be. */
+export type TrackUploadResult = {
+  submissionId: string
+  videoCID: string
+  publicUrl: string
+  uploadTimestamp: string
+  type: 'land' | 'plant'
+  status: 'awaiting_plant' | 'tracked'
+  treesPlanted?: number
+  treeType?: string
+  reverseGeocode?: string
+}
+
+export interface TrackStorageDeps {
+  configured: () => boolean
+  upload: typeof uploadGwrClipToGcs
+  remove: typeof deleteFromGcs
+}
+
+const OID_RE = /^[a-fA-F0-9]{24}$/
+
+const clean = (v: unknown) =>
+  typeof v === 'string' && v.trim() ? v.trim() : undefined
+
+/** The planter's name as typed, trimmed and capped; nothing for blank. */
+export function cleanPlanterName(raw: unknown): string | undefined {
+  // Control characters out: the name lands in file names and the CSV.
+  const name = [...(clean(raw) ?? '')]
+    .filter(ch => ch.charCodeAt(0) > 0x1f && ch.charCodeAt(0) !== 0x7f)
+    .join('')
+    .trim()
+  return name ? name.slice(0, 120) : undefined
+}
+
+/**
+ * `treegens-track-20261119-091500-amina-3f9a2c-before.mp4`: sortable, with
+ * the planter and the tree, and which clip it is, so a folder of downloads
+ * keeps each tree's two clips side by side.
+ */
+export function trackDownloadFilename(params: {
+  filmedAt: Date
+  planterName?: string
+  treeId: string
+  kind: 'land' | 'plant'
+  extension: string
+}): string {
+  const parts = [
+    'treegens-track',
+    utcStamp(params.filmedAt),
+    slugify(params.planterName),
+    params.treeId.slice(-6).toLowerCase(),
+    params.kind === 'land' ? 'before' : 'after',
+  ].filter(Boolean)
+  return `${parts.join('-')}.${params.extension}`
+}
+
+function resultOf(doc: any): TrackUploadResult {
+  return {
+    submissionId: String(doc.treeId),
+    videoCID: doc.objectName,
+    publicUrl: doc.publicUrl,
+    uploadTimestamp: new Date(doc.uploadedAt ?? Date.now()).toISOString(),
+    type: doc.kind,
+    status: doc.kind === 'land' ? 'awaiting_plant' : 'tracked',
+    ...(typeof doc.treesPlanted === 'number'
+      ? { treesPlanted: doc.treesPlanted }
+      : {}),
+    ...(clean(doc.treeType) ? { treeType: doc.treeType } : {}),
+    ...(clean(doc.reverseGeocode)
+      ? { reverseGeocode: doc.reverseGeocode }
+      : {}),
+  }
+}
+
+// ------------------------------------------------------------ dashboard
+
+export type TrackCountSource = 'planter' | 'ai' | 'ai_pending' | 'none'
+
+export interface TrackClipView {
+  id: string
+  kind: 'land' | 'plant'
+  publicUrl: string
+  /** Serves with Content-Disposition: attachment, so it downloads. */
+  downloadUrl: string
+  downloadFilename: string
+  mimeType?: string
+  sizeBytes?: number
+  gps?: { latitude: number; longitude: number; accuracyMeters?: number }
+  gpsEnd?: string
+  /** How many fixes were heard while filming (the path itself stays here). */
+  gpsPathPoints?: number
+  reverseGeocode?: string
+  filmedAt: string
+  uploadedAt: string
+}
+
+export interface TrackTreeView {
+  id: string
+  /** Order the trees were started in, from 1. */
+  number: number
+  planterName?: string
+  filmedAt: string
+  gps?: TrackClipView['gps']
+  reverseGeocode?: string
+  treeType?: string
+  isMangrove: boolean
+  /** The planter's own figure (not for mangroves). */
+  treesPlanted?: number
+  ai?: {
+    status: 'pending' | 'counting' | 'done' | 'failed' | 'skipped'
+    treeCount?: number
+    /** The plant clip with the AI boxes drawn on it. */
+    videoUrl?: string
+    error?: string
+  }
+  /** What this tree adds to the total, and where that comes from. */
+  count: number
+  countSource: TrackCountSource
+  /** Both clips are on the server. */
+  complete: boolean
+  land: TrackClipView
+  plant?: TrackClipView
+}
+
+export interface TrackTotals {
+  /** Trees with both clips. */
+  trees: number
+  /** Land clips still waiting for their plant clip. */
+  awaitingPlant: number
+  /** Planted, per the counting rule. */
+  planted: number
+  /** Mangrove trees whose AI count has not come yet. */
+  aiPending: number
+  clips: number
+  bytes: number
+  planters: { name: string; trees: number; planted: number }[]
+}
+
+function gpsOf(doc: any): TrackClipView['gps'] {
+  const g = doc.gpsCoordinates
+  if (!g || typeof g.latitude !== 'number' || typeof g.longitude !== 'number')
+    return undefined
+  return {
+    latitude: g.latitude,
+    longitude: g.longitude,
+    ...(typeof g.accuracyMeters === 'number'
+      ? { accuracyMeters: g.accuracyMeters }
+      : {}),
+  }
+}
+
+function pathPoints(raw: unknown): number | undefined {
+  if (typeof raw !== 'string' || !raw) return undefined
+  try {
+    const parsed = JSON.parse(raw)
+    return Array.isArray(parsed) ? parsed.length : undefined
+  } catch {
+    return undefined
+  }
+}
+
+function filmedAtOf(doc: any): Date {
+  return chooseFilmedAt({
+    videoCreatedAt: doc.videoCreatedAt,
+    recordedAt: doc.recordedAt,
+    uploadedAt: new Date(doc.uploadedAt ?? doc.createdAt ?? Date.now()),
+  }).filmedAt
+}
+
+export function toTrackClipView(doc: any): TrackClipView {
+  return {
+    id: String(doc._id),
+    kind: doc.kind,
+    publicUrl: doc.publicUrl,
+    downloadUrl: doc.publicUrl,
+    downloadFilename: doc.downloadFilename,
+    mimeType: clean(doc.mimeType),
+    sizeBytes: typeof doc.sizeBytes === 'number' ? doc.sizeBytes : undefined,
+    gps: gpsOf(doc),
+    gpsEnd: clean(doc.gpsEnd),
+    gpsPathPoints: pathPoints(doc.gpsPath),
+    reverseGeocode: clean(doc.reverseGeocode),
+    filmedAt: filmedAtOf(doc).toISOString(),
+    uploadedAt: new Date(doc.uploadedAt ?? doc.createdAt).toISOString(),
+  }
+}
+
+/** The planting app's rule: a mangrove counts by AI, anything else by the
+ * planter's own figure. */
+export function countOf(
+  land: any,
+  plant: any | undefined,
+): {
+  count: number
+  source: TrackCountSource
+} {
+  if (!plant) return { count: 0, source: 'none' }
+  if (plant.isMangrove) {
+    if (typeof plant.aiTreeCount === 'number') {
+      return { count: plant.aiTreeCount, source: 'ai' }
+    }
+    return { count: 0, source: plant.aiEligible ? 'ai_pending' : 'none' }
+  }
+  const n = Number(plant.treesPlanted)
+  return Number.isFinite(n) && n > 0
+    ? { count: n, source: 'planter' }
+    : { count: 0, source: 'none' }
+}
+
+export function toTrackTreeView(
+  land: any,
+  plant: any | undefined,
+  number: number,
+): TrackTreeView {
+  const { count, source } = countOf(land, plant)
+  const landView = toTrackClipView(land)
+  return {
+    id: String(land._id),
+    number,
+    planterName: clean(land.planterName) ?? clean(plant?.planterName),
+    filmedAt: landView.filmedAt,
+    gps: landView.gps,
+    reverseGeocode: landView.reverseGeocode ?? clean(plant?.reverseGeocode),
+    treeType: clean(plant?.treeType),
+    isMangrove: plant?.isMangrove === true,
+    treesPlanted:
+      plant && !plant.isMangrove && typeof plant.treesPlanted === 'number'
+        ? plant.treesPlanted
+        : undefined,
+    ai:
+      plant?.isMangrove === true
+        ? {
+            status: plant.aiStatus || 'skipped',
+            treeCount:
+              typeof plant.aiTreeCount === 'number'
+                ? plant.aiTreeCount
+                : undefined,
+            videoUrl: clean(plant.aiVideoUrl),
+            error:
+              plant.aiStatus === 'failed' ? clean(plant.aiError) : undefined,
+          }
+        : undefined,
+    count,
+    countSource: source,
+    complete: Boolean(plant),
+    land: landView,
+    plant: plant ? toTrackClipView(plant) : undefined,
+  }
+}
+
+export interface TrackListParams {
+  page: number
+  limit: number
+  /** Only this planter's trees (as typed, any case). */
+  planter?: string
+  /** Only trees whose land was filmed in [from, to). */
+  from?: Date
+  to?: Date
+}
+
+/** Every land clip's place in line, for the tree numbers. Light: ids only. */
+async function treeNumbers(): Promise<Map<string, number>> {
+  const lands: any[] = await TrackClip.find({ kind: 'land' }, '_id')
+    .sort({ uploadedAt: 1, _id: 1 })
+    .lean()
+  return new Map(lands.map((l, i) => [String(l._id), i + 1]))
+}
+
+const TOTALS_FIELDS =
+  '_id kind treeId planterName treesPlanted isMangrove aiEligible aiStatus aiTreeCount sizeBytes'
+
+export async function trackTotals(): Promise<TrackTotals> {
+  const rows: any[] = await TrackClip.find({}, TOTALS_FIELDS).lean()
+  const plantByTree = new Map<string, any>()
+  for (const r of rows) {
+    if (r.kind === 'plant') plantByTree.set(String(r.treeId), r)
+  }
+  const totals: TrackTotals = {
+    trees: 0,
+    awaitingPlant: 0,
+    planted: 0,
+    aiPending: 0,
+    clips: rows.length,
+    bytes: 0,
+    planters: [],
+  }
+  const planters = new Map<string, TrackTotals['planters'][number]>()
+  for (const r of rows) {
+    totals.bytes += typeof r.sizeBytes === 'number' ? r.sizeBytes : 0
+    if (r.kind !== 'land') continue
+    const plant = plantByTree.get(String(r._id))
+    if (!plant) {
+      totals.awaitingPlant++
+      continue
+    }
+    totals.trees++
+    const { count, source } = countOf(r, plant)
+    totals.planted += count
+    if (source === 'ai_pending') totals.aiPending++
+    const name = clean(r.planterName) ?? 'Unnamed'
+    const key = name.toLowerCase()
+    const p = planters.get(key) ?? { name, trees: 0, planted: 0 }
+    p.trees++
+    p.planted += count
+    planters.set(key, p)
+  }
+  totals.planters = [...planters.values()].sort(
+    (a, b) => b.planted - a.planted || b.trees - a.trees,
+  )
+  return totals
+}
+
+const escapeRegex = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+
+function landFilter(params: Omit<TrackListParams, 'page' | 'limit'>) {
+  const filter: Record<string, unknown> = { kind: 'land' }
+  const planter = cleanPlanterName(params.planter)
+  if (planter) {
+    filter.planterName = new RegExp(`^${escapeRegex(planter)}$`, 'i')
+  }
+  return filter
+}
+
+/** Trees newest first, each with both clips, and the totals. */
+export async function listTrackTrees(params: TrackListParams) {
+  const page = Math.max(1, Math.floor(params.page) || 1)
+  const limit = Math.min(200, Math.max(1, Math.floor(params.limit) || 50))
+  const filter = landFilter(params)
+  const ranged = Boolean(params.from || params.to)
+  // A day of filming is worked out per clip (its header, the phone, the
+  // upload), so a range is applied over the lands here, not in the query.
+  let lands: any[]
+  let total: number
+  if (ranged) {
+    const all: any[] = await TrackClip.find(filter)
+      .sort({ uploadedAt: -1, _id: -1 })
+      .lean()
+    const from = params.from?.getTime() ?? -Infinity
+    const to = params.to?.getTime() ?? Infinity
+    const inRange = all.filter(l => {
+      const t = filmedAtOf(l).getTime()
+      return t >= from && t < to
+    })
+    total = inRange.length
+    lands = inRange.slice((page - 1) * limit, page * limit)
+  } else {
+    ;[lands, total] = await Promise.all([
+      TrackClip.find(filter)
+        .sort({ uploadedAt: -1, _id: -1 })
+        .skip((page - 1) * limit)
+        .limit(limit)
+        .lean(),
+      TrackClip.countDocuments(filter),
+    ])
+  }
+  const [plants, numbers, totals] = await Promise.all([
+    lands.length
+      ? TrackClip.find({
+          kind: 'plant',
+          treeId: { $in: lands.map(l => l._id) },
+        }).lean()
+      : Promise.resolve([]),
+    treeNumbers(),
+    trackTotals(),
+  ])
+  const plantByTree = new Map((plants as any[]).map(p => [String(p.treeId), p]))
+  return {
+    trees: lands.map(l =>
+      toTrackTreeView(
+        l,
+        plantByTree.get(String(l._id)),
+        numbers.get(String(l._id)) ?? 0,
+      ),
+    ),
+    pagination: {
+      page,
+      limit,
+      total,
+      totalPages: Math.max(1, Math.ceil(total / limit)),
+    },
+    totals,
+  }
+}
+
+export async function getTrackTree(id: string): Promise<TrackTreeView | null> {
+  if (!OID_RE.test(id)) return null
+  const land: any = await TrackClip.findOne({ _id: id, kind: 'land' }).lean()
+  if (!land) return null
+  const [plant, numbers] = await Promise.all([
+    TrackClip.findOne({ kind: 'plant', treeId: land._id }).lean(),
+    treeNumbers(),
+  ])
+  return toTrackTreeView(land, plant ?? undefined, numbers.get(id) ?? 0)
+}
+
+/** Every tree, oldest first, for the CSV and the URL list. */
+async function everyTree(): Promise<TrackTreeView[]> {
+  const [lands, plants] = await Promise.all([
+    TrackClip.find({ kind: 'land' }).sort({ uploadedAt: 1, _id: 1 }).lean(),
+    TrackClip.find({ kind: 'plant' }).lean(),
+  ])
+  const plantByTree = new Map((plants as any[]).map(p => [String(p.treeId), p]))
+  return (lands as any[]).map((l, i) =>
+    toTrackTreeView(l, plantByTree.get(String(l._id)), i + 1),
+  )
+}
+
+export const TRACK_MANIFEST_HEADER = [
+  'tree_number',
+  'tree_id',
+  'planter',
+  'filmed_at_utc',
+  'latitude',
+  'longitude',
+  'gps_accuracy_m',
+  'place',
+  'tree_type',
+  'mangrove',
+  'planter_count',
+  'ai_count',
+  'ai_status',
+  'count',
+  'count_source',
+  'complete',
+  'before_filename',
+  'before_url',
+  'after_filename',
+  'after_url',
+  'ai_video_url',
+]
+
+export async function trackManifestCsv(): Promise<string> {
+  const trees = await everyTree()
+  const lines = [TRACK_MANIFEST_HEADER.join(',')]
+  for (const t of trees) {
+    lines.push(
+      [
+        t.number,
+        t.id,
+        t.planterName,
+        t.filmedAt,
+        t.gps?.latitude,
+        t.gps?.longitude,
+        t.gps?.accuracyMeters,
+        t.reverseGeocode,
+        t.treeType,
+        t.isMangrove ? 'yes' : 'no',
+        t.treesPlanted,
+        t.ai?.treeCount,
+        t.ai?.status,
+        t.count,
+        t.countSource,
+        t.complete ? 'yes' : 'no',
+        t.land.downloadFilename,
+        t.land.downloadUrl,
+        t.plant?.downloadFilename,
+        t.plant?.downloadUrl,
+        t.ai?.videoUrl,
+      ]
+        .map(csvCell)
+        .join(','),
+    )
+  }
+  return `${lines.join('\r\n')}\r\n`
+}
+
+/** One URL per line, before then after, for `wget --content-disposition -i`. */
+export async function trackUrlList(): Promise<string> {
+  const trees = await everyTree()
+  const urls: string[] = []
+  for (const t of trees) {
+    urls.push(t.land.downloadUrl)
+    if (t.plant) urls.push(t.plant.downloadUrl)
+  }
+  return urls.length ? `${urls.join('\n')}\n` : ''
+}
+
+// ------------------------------------------------------------- storing
+
+export class TrackStorageUnavailableError extends Error {
+  code = 'TRACK_STORAGE_UNAVAILABLE'
+  constructor() {
+    super(
+      'Track clips need Google Cloud Storage (GCS_BUCKET) on this deployment',
+    )
+  }
+}
+
+class TrackService {
+  deps: TrackStorageDeps = {
+    configured: isGcsConfigured,
+    upload: uploadGwrClipToGcs,
+    remove: deleteFromGcs,
+  }
+
+  /** This clip, if this phone already sent its bytes (any upload id). */
+  async findStoredClip(
+    filePath: string,
+    kind: 'land' | 'plant',
+    device: string,
+  ): Promise<TrackUploadResult | null> {
+    const contentMd5 = await md5OfFile(filePath).catch(() => null)
+    if (!contentMd5) return null
+    const same: any = await TrackClip.findOne({ device, kind, contentMd5 })
+      .sort({ uploadedAt: 1 })
+      .lean()
+    return same ? resultOf(same) : null
+  }
+
+  /**
+   * Store one clip from the session's file and record it. Refusals are
+   * UploadRefusedError (final for the phone); anything else is a fault the
+   * session retries with the bytes kept. The session deletes its file.
+   */
+  async storeClip(
+    file: TrackStoredFile,
+    input: TrackClipInput,
+  ): Promise<TrackUploadResult> {
+    const byId: any = await TrackClip.findOne({
+      uploadId: input.uploadId,
+    }).lean()
+    if (byId) return resultOf(byId)
+
+    if (!file.size || !(await fileHasBytes(file.path))) {
+      throw new UploadRefusedError('UPLOAD_EMPTY')
+    }
+    const contentMd5 = await md5OfFile(file.path)
+    // The same clip sent again from this phone under another id.
+    const same: any = await TrackClip.findOne({
+      device: input.device,
+      kind: input.kind,
+      contentMd5,
+    })
+      .sort({ uploadedAt: 1 })
+      .lean()
+    if (same) return resultOf(same)
+
+    // A hex string: Mongoose casts it to the ObjectId the schema stores.
+    let treeId: string
+    let land: any = null
+    if (input.kind === 'plant') {
+      if (!input.treeId || !OID_RE.test(input.treeId)) {
+        throw new UploadRefusedError('LAND_NOT_FOUND')
+      }
+      land = await TrackClip.findOne({
+        _id: input.treeId,
+        kind: 'land',
+        device: input.device,
+      }).lean()
+      if (!land) throw new UploadRefusedError('LAND_NOT_FOUND')
+      const taken = await TrackClip.exists({
+        kind: 'plant',
+        treeId: land._id,
+      })
+      if (taken) throw new UploadRefusedError('PLANT_NOT_ALLOWED')
+      treeId = String(land._id)
+    } else {
+      treeId = new mongoose.Types.ObjectId().toHexString()
+    }
+
+    if (!this.deps.configured()) throw new TrackStorageUnavailableError()
+
+    const videoCreatedAt = await mp4CreationTime(file.path)
+    const uploadedAt = new Date()
+    const filmedAt = chooseFilmedAt({
+      videoCreatedAt,
+      recordedAt: input.recordedAt,
+      uploadedAt,
+    }).filmedAt
+    const extension = gwrFileExtension(file.originalname, file.mimetype)
+    const objectName = `${TRACK_STORAGE_PREFIX}${uuidv4()}.${extension}`
+    const planterName =
+      cleanPlanterName(input.planterName) ?? clean(land?.planterName)
+    const downloadFilename = trackDownloadFilename({
+      filmedAt,
+      planterName,
+      treeId: String(treeId),
+      kind: input.kind,
+      extension,
+    })
+    const mimeType = gwrMimeForExtension(extension)
+    const stored = await this.deps.upload(
+      file.path,
+      objectName,
+      mimeType,
+      downloadFilename,
+      'track',
+    )
+
+    const isPlant = input.kind === 'plant'
+    const treeType = isPlant ? clean(input.treeType) : undefined
+    const isMangrove = isPlant && isMangroveTreeType(treeType)
+    const hasGps =
+      typeof input.latitude === 'number' && typeof input.longitude === 'number'
+    const ai = isMangrove
+      ? { aiEligible: true, ...initialAiFields(uploadedAt) }
+      : { aiEligible: false, aiStatus: 'skipped' as const }
+    try {
+      const doc: any = await TrackClip.create({
+        ...(isPlant ? {} : { _id: treeId }),
+        uploadId: input.uploadId,
+        device: input.device,
+        kind: input.kind,
+        treeId,
+        clientGroupId: input.clientGroupId,
+        planterName,
+        objectName: stored.videoCID,
+        publicUrl: stored.publicUrl,
+        downloadFilename,
+        originalFilename: file.originalname,
+        mimeType,
+        sizeBytes: file.size,
+        contentMd5,
+        gpsCoordinates: hasGps
+          ? {
+              latitude: input.latitude,
+              longitude: input.longitude,
+              ...(typeof input.gpsAccuracy === 'number' &&
+              input.gpsAccuracy >= 0
+                ? { accuracyMeters: input.gpsAccuracy }
+                : {}),
+            }
+          : undefined,
+        gpsEnd: clean(input.gpsEnd),
+        gpsPath: clean(input.gpsPath),
+        reverseGeocode: clean(input.reverseGeocode),
+        treesPlanted:
+          isPlant && !isMangrove && typeof input.treesPlanted === 'number'
+            ? input.treesPlanted
+            : undefined,
+        treeType,
+        isMangrove: isPlant ? isMangrove : undefined,
+        recordedAt: input.recordedAt,
+        videoCreatedAt: videoCreatedAt ?? undefined,
+        uploadedAt,
+        ...ai,
+      })
+      return resultOf(
+        typeof doc?.toObject === 'function' ? doc.toObject() : doc,
+      )
+    } catch (error) {
+      await this.deps.remove(objectName).catch(() => undefined)
+      // A twin of this very upload won the race: answer with it.
+      if ((error as { code?: number })?.code === 11000) {
+        const winner: any = await TrackClip.findOne({
+          uploadId: input.uploadId,
+        }).lean()
+        if (winner) return resultOf(winner)
+      }
+      throw error
+    }
+  }
+
+  /**
+   * Take a tree out: both clips, their objects and the AI overlay copy.
+   * Returns false when there is no such tree.
+   */
+  async removeTree(id: string): Promise<boolean> {
+    if (!OID_RE.test(id)) return false
+    const clips: any[] = await TrackClip.find({ treeId: id }).lean()
+    if (!clips.length) return false
+    for (const c of clips) {
+      await TrackClip.deleteOne({ _id: c._id })
+      for (const name of [c.objectName, c.aiVideoObjectName]) {
+        if (typeof name === 'string' && name.startsWith(TRACK_STORAGE_PREFIX)) {
+          await this.deps
+            .remove(name)
+            .catch(err =>
+              console.warn(`[track] ${c._id}: object ${name} not removed`, err),
+            )
+        }
+      }
+    }
+    return true
+  }
+}
+
+async function fileHasBytes(filePath: string): Promise<boolean> {
+  try {
+    return (await fs.promises.stat(filePath)).size > 0
+  } catch {
+    return false
+  }
+}
+
+export const trackService = new TrackService()
+
+/** What the capture page needs to know. */
+export function trackConfig() {
+  return {
+    aiCountEnabled: gwrAiEnabled(),
+    adminEnabled: Boolean(process.env.TRACK_ADMIN_KEY?.trim()),
+  }
+}
