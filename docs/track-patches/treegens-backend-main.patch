+import { timingSafeEqual } from 'node:crypto'
+import express, { NextFunction, Request, Response } from 'express'
+import { gwrAdminLimiter, gwrReadLimiter } from '../middleware/rateLimits'
+import {
+  getTrackTree,
+  listTrackTrees,
+  trackConfig,
+  trackManifestCsv,
+  trackService,
+  trackTotals,
+  trackUrlList,
+  TRACK_DEVICE_PREFIX,
+} from '../services/trackService'
+import {
+  sendBadRequest,
+  sendError,
+  sendNotFound,
+  sendSuccess,
+} from '../utils/responseHelpers'
+import { buildUploadSessionRouter } from './uploadSessions'
+
+/**
+ * treegens.app/track: the planting app's capture with no crypto, and a
+ * public dashboard of every tree with both of its videos.
+ *
+ * Public on purpose, like /api/gwr: no account and no wallet. A phone names
+ * itself with a random id it minted (`x-track-device`) so its land and plant
+ * clips can find each other, and its planter types a name. Nothing here
+ * touches submissions, users, verifiers, rewards, OTC or MGRO.
+ */
+const router = express.Router()
+
+const DEVICE_HEADER = 'x-track-device'
+const ADMIN_KEY_HEADER = 'x-track-admin-key'
+const DEVICE_RE =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
+
+/**
+ * The phone's own id, as the session owner. Not a secret and not an
+ * account: it only scopes a phone's upload sessions to that phone, exactly
+ * as a wallet scopes a planter's.
+ */
+export const trackDevice = (
+  req: Request,
+  res: Response,
+  next: NextFunction,
+) => {
+  const id = String(req.header(DEVICE_HEADER) ?? '').trim()
+  if (!DEVICE_RE.test(id)) {
+    return res.status(400).json({
+      error: 'This phone has no tracking id yet. Reload the page.',
+      code: 'TRACK_DEVICE_MISSING',
+    })
+  }
+  req.user = {
+    userId: `${TRACK_DEVICE_PREFIX}${id.toLowerCase()}`,
+    walletAddress: `${TRACK_DEVICE_PREFIX}${id.toLowerCase()}`,
+  }
+  next()
+}
+
+// The resumable upload, the same protocol as plantings.
+router.use('/uploads', buildUploadSessionRouter(trackDevice))
+
+router.get('/config', gwrReadLimiter, (_req, res) =>
+  sendSuccess(res, 'Track config', trackConfig()),
+)
+
+const instant = (v: unknown): Date | undefined => {
+  if (typeof v !== 'string' || !v.trim()) return undefined
+  const d = new Date(v)
+  return Number.isNaN(d.getTime()) ? undefined : d
+}
+
+/**
+ * @swagger
+ * /api/track/trees:
+ *   get:
+ *     summary: Every tree tracked at treegens.app/track, newest first, with both videos
+ *     tags: [Track]
+ *     parameters:
+ *       - { in: query, name: page, schema: { type: integer, default: 1 } }
+ *       - { in: query, name: limit, schema: { type: integer, default: 50, maximum: 200 } }
+ *       - { in: query, name: planter, schema: { type: string } }
+ *       - { in: query, name: from, schema: { type: string, format: date-time } }
+ *       - { in: query, name: to, schema: { type: string, format: date-time } }
+ *     responses:
+ *       200:
+ *         description: '{ trees, pagination, totals }'
+ */
+router.get('/trees', gwrReadLimiter, async (req: Request, res: Response) => {
+  try {
+    const data = await listTrackTrees({
+      page: parseInt(String(req.query.page ?? '1'), 10),
+      limit: parseInt(String(req.query.limit ?? '50'), 10),
+      planter: typeof req.query.planter === 'string' ? req.query.planter : '',
+      from: instant(req.query.from),
+      to: instant(req.query.to),
+    })
+    return sendSuccess(res, 'Tracked trees', data)
+  } catch (error: any) {
+    return sendError(res, error.message || 'Failed to list trees')
+  }
+})
+
+router.get('/totals', gwrReadLimiter, async (_req, res) => {
+  try {
+    return sendSuccess(res, 'Track totals', await trackTotals())
+  } catch (error: any) {
+    return sendError(res, error.message || 'Failed to count trees')
+  }
+})
+
+router.get('/trees.csv', gwrReadLimiter, async (_req, res) => {
+  try {
+    const csv = await trackManifestCsv()
+    res.setHeader('Content-Type', 'text/csv; charset=utf-8')
+    res.setHeader(
+      'Content-Disposition',
+      'attachment; filename="treegens-track-trees.csv"',
+    )
+    return res.status(200).send(csv)
+  } catch (error: any) {
+    return sendError(res, error.message || 'Failed to build the CSV')
+  }
+})
+
+router.get('/urls.txt', gwrReadLimiter, async (_req, res) => {
+  try {
+    const txt = await trackUrlList()
+    res.setHeader('Content-Type', 'text/plain; charset=utf-8')
+    res.setHeader(
+      'Content-Disposition',
+      'attachment; filename="treegens-track-urls.txt"',
+    )
+    return res.status(200).send(txt)
+  } catch (error: any) {
+    return sendError(res, error.message || 'Failed to build the URL list')
+  }
+})
+
+router.get('/trees/:id', gwrReadLimiter, async (req, res) => {
+  try {
+    const tree = await getTrackTree(String(req.params.id ?? ''))
+    if (!tree) return sendNotFound(res, 'Tree')
+    return sendSuccess(res, 'Tracked tree', tree)
+  } catch (error: any) {
+    return sendError(res, error.message || 'Failed to read the tree')
+  }
+})
+
+const safeEqual = (a: string, b: string) => {
+  const ab = Buffer.from(a)
+  const bb = Buffer.from(b)
+  return ab.length === bb.length && timingSafeEqual(ab, bb)
+}
+
+/** Deleting a tree needs TRACK_ADMIN_KEY; closed while it is unset. */
+const requireAdminKey = (req: Request, res: Response, next: NextFunction) => {
+  const expected = process.env.TRACK_ADMIN_KEY?.trim()
+  if (!expected) {
+    return res.status(403).json({
+      error: 'Track admin actions are disabled (TRACK_ADMIN_KEY not set)',
+      code: 'ADMIN_DISABLED',
+    })
+  }
+  const given = String(req.header(ADMIN_KEY_HEADER) ?? '').trim()
+  if (!given || !safeEqual(given, expected)) {
+    console.warn('Track admin key rejected', { path: req.path, ip: req.ip })
+    return res
+      .status(403)
+      .json({ error: 'Admin key is wrong', code: 'ADMIN_KEY_INVALID' })
+  }
+  next()
+}
+
+router.get('/admin/check', gwrAdminLimiter, requireAdminKey, (_req, res) =>
+  res.status(204).end(),
+)
+
+router.delete(
+  '/trees/:id',
+  gwrAdminLimiter,
+  requireAdminKey,
+  async (req: Request, res: Response) => {
+    try {
+      const id = String(req.params.id ?? '')
+      if (!/^[a-fA-F0-9]{24}$/.test(id))
+        return sendBadRequest(res, 'Invalid id')
+      if (!(await trackService.removeTree(id))) return sendNotFound(res, 'Tree')
+      return sendSuccess(res, 'Tree removed', { id })
+    } catch (error: any) {
+      return sendError(res, error.message || 'Failed to remove the tree')
+    }
+  },
+)
+
+export default router
