+   *     security:
+   *       - bearerAuth: []
+   *     requestBody:
+   *       required: true
+   *       content:
+   *         application/json:
+   *           schema:
+   *             type: object
+   *             required: [uploadId, type, size, mimeType, latitude, longitude]
+   *             properties:
+   *               uploadId: { type: string, format: uuid }
+   *               type: { type: string, enum: [land, plant] }
+   *               size: { type: integer, minimum: 1 }
+   *               mimeType: { type: string, example: video/mp4 }
+   *               fileName: { type: string, maxLength: 128 }
+   *               latitude: { type: number }
+   *               longitude: { type: number }
+   *               submissionId: { type: string, description: "Plant only (24-hex). Land must not send it." }
+   *               clientGroupId: { type: string, description: "The client's group id (/^[A-Za-z0-9_-]{1,64}$/); links a plant to its land." }
+   *               landQueued:
+   *                 type: boolean
+   *                 description: "Plant only. true while the phone still holds this group's land clip in its queue: the server then answers LAND_NOT_READY rather than guess the planting by filming time. Send false once no land of the group is queued. Kept on the session until changed."
+   *               treesPlanted: { type: number }
+   *               treeType: { type: string }
+   *               reverseGeocode: { type: string }
+   *               recordedAt: { type: string, format: date-time }
+   *               gpsEnd: { type: string, description: "lat,lng or lat,lng,accuracy" }
+   *               gpsEndSource: { type: string, enum: [filming, submit] }
+   *               gpsAccuracy: { type: number }
+   *               gpsPath: { type: string, description: "JSON array of [lat, lng] or [lat, lng, accuracy]" }
+   *     responses:
+   *       201: { description: Session created }
+   *       200: { description: Existing session }
+   *       400: { description: VALIDATION_ERROR (with details) }
+   *       401: { description: Unauthorized }
+   *       409: { description: UPLOAD_ID_CONFLICT }
