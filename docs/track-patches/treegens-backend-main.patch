index 0000000..f8c637d
--- /dev/null
+++ b/src/models/TrackClip.ts
@@ -0,0 +1,82 @@
+import mongoose from 'mongoose'
+import { clipAiFields, gpsSchema } from './GwrVideo'
+
+/**
+ * One clip of a tree filmed at treegens.app/track: the land ("before") or
+ * the plant ("after") clip, filmed with the same screen and sent through the
+ * same resumable upload as a planting.
+ *
+ * Deliberately not a Submission: no wallet, no verifier vote, no MGRO and no
+ * OTC deal ever touch these rows. They exist so a team can count what it
+ * planted and pull both videos of every tree down from one dashboard.
+ *
+ * A tree is its land clip and the plant clip filmed after it. The land
+ * clip's own _id is the tree's id (`treeId` on both rows); the phone is given
+ * it as the "submissionId" its upload queue already knows how to wait for.
+ */
+const trackClipSchema = new mongoose.Schema(
+  {
+    /** The upload session's id: a resend of the same clip finds this row. */
+    uploadId: { type: String, required: true, unique: true, index: true },
+    /** The phone that filmed it (`track:<device id>`, never a wallet). */
+    device: { type: String, required: true, index: true },
+    kind: { type: String, enum: ['land', 'plant'], required: true },
+    /** The land clip's _id, on the land row too. */
+    treeId: {
+      type: mongoose.Schema.Types.ObjectId,
+      required: true,
+      index: true,
+    },
+    /** The phone's id for the tree, linking its two clips. */
+    clientGroupId: { type: String, required: false },
+    /** Free text, as typed on the phone. No account behind it. */
+    planterName: { type: String, required: false, maxlength: 120 },
+
+    /** Object path in the GCS bucket (`track/<uuid>.<ext>`). */
+    objectName: { type: String, required: true },
+    /** Public https URL. Serves with Content-Disposition: attachment. */
+    publicUrl: { type: String, required: true },
+    downloadFilename: { type: String, required: true },
+    originalFilename: { type: String, required: false },
+    mimeType: { type: String, required: false },
+    sizeBytes: { type: Number, required: false, min: 0 },
+    /** MD5 of the bytes, hex: the same clip sent again is answered with the
+     * first copy instead of a second tree. */
+    contentMd5: { type: String, required: false, index: true },
+
+    gpsCoordinates: { type: gpsSchema, required: false },
+    /** "lat,lng" or "lat,lng,accuracy" where filming ended. */
+    gpsEnd: { type: String, required: false, maxlength: 200 },
+    /** JSON [[lat,lng(,accuracy)],…] heard while filming. */
+    gpsPath: { type: String, required: false },
+    reverseGeocode: { type: String, required: false, maxlength: 500 },
+
+    /** Plant clip only: the planter's own count (none for mangroves, where
+     * the AI count is the figure, exactly as in the planting app). */
+    treesPlanted: { type: Number, required: false, min: 0 },
+    treeType: { type: String, required: false, maxlength: 100 },
+    isMangrove: { type: Boolean, required: false },
+    /** Queued for the AI count: a mangrove plant clip. */
+    aiEligible: { type: Boolean, default: false, index: true },
+
+    /** The phone's word on when filming ended. */
+    recordedAt: { type: Date, required: false },
+    /** The clip's own header time, when it has one. */
+    videoCreatedAt: { type: Date, required: false },
+    uploadedAt: { type: Date, default: Date.now, index: true },
+
+    ...clipAiFields,
+  },
+  { timestamps: true },
+)
+
+trackClipSchema.index({ treeId: 1, kind: 1 })
+trackClipSchema.index({ device: 1, clientGroupId: 1, kind: 1 })
+
+export type TrackClipDoc = mongoose.InferSchemaType<typeof trackClipSchema> & {
+  _id: mongoose.Types.ObjectId
+}
+
+const TrackClip = mongoose.model('TrackClip', trackClipSchema)
+
+export default TrackClip
