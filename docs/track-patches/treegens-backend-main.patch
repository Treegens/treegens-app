diff --git a/src/routes/track.routes.test.ts b/src/routes/track.routes.test.ts
new file mode 100644
index 0000000..42759f0
--- /dev/null
+++ b/src/routes/track.routes.test.ts
@@ -0,0 +1,517 @@
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import type { AddressInfo } from 'node:net'
+import os from 'node:os'
+import path from 'node:path'
+import { after, afterEach, before, beforeEach, test } from 'node:test'
+import express from 'express'
+import Submission from '../models/Submission'
+import TrackClip from '../models/TrackClip'
+import UploadSession from '../models/UploadSession'
+import {
+  resetGwrAiPauseForTests,
+  sweepGwrAiCounts,
+} from '../services/gwrAiCountService'
+import SubmissionService from '../services/submissionService'
+import { trackService, TRACK_AI_TARGET } from '../services/trackService'
+import { processingSettled } from '../services/uploadSessionService'
+import { installFakeModel } from '../testing/fakeModel'
+import '../testing/routeEnv'
+import trackRoutes from './track'
+import { isUploadChunkRequest } from './uploadSessions'
+
+/**
+ * treegens.app/track end to end through the real session protocol: a phone
+ * films a land and a plant clip, they go up in chunks to /api/track/uploads,
+ * and the dashboard lists the tree with both videos and its count. What has
+ * to hold: nothing ever reaches submissions; the plant finds its own land
+ * by the phone's group id; a phone can never attach a plant to another
+ * phone's tree; a resend is the same tree, not a second one; mangroves are
+ * counted by the AI sweep and anything else by the planter's figure.
+ */
+
+const saved = {
+  uploadClip: SubmissionService.prototype.uploadClip,
+  deps: trackService.deps,
+  error: console.error,
+  warn: console.warn,
+  log: console.log,
+  dir: process.env.UPLOAD_SESSION_DIR,
+}
+
+let base = ''
+let server: ReturnType<express.Express['listen']>
+let sessions: ReturnType<typeof installFakeModel>
+let clips: ReturnType<typeof installFakeModel>
+let submissions: ReturnType<typeof installFakeModel>
+let stored: { objectName: string; downloadFilename: string; bytes: Buffer }[] =
+  []
+let tmpDir = ''
+let counter = 0
+let device = ''
+let plantingUploads = 0
+
+const uuid = (n: number, tail = 4) =>
+  `00000000-0000-${tail}000-8000-${String(n).padStart(12, '0')}`
+const nextId = () => uuid(++counter)
+
+before(() => {
+  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'treegens-track-test-'))
+  process.env.UPLOAD_SESSION_DIR = tmpDir
+  console.error = () => {}
+  console.warn = () => {}
+  console.log = () => {}
+  const app = express()
+  app.use(express.json())
+  app.use('/api/track', trackRoutes)
+  server = app.listen(0)
+  base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`
+})
+
+after(() => {
+  server?.close()
+  console.error = saved.error
+  console.warn = saved.warn
+  console.log = saved.log
+  process.env.UPLOAD_SESSION_DIR = saved.dir
+  fs.rmSync(tmpDir, { recursive: true, force: true })
+})
+
+beforeEach(() => {
+  device = uuid(++counter)
+  sessions = installFakeModel(UploadSession, {
+    unique: ['uploadId'],
+    defaults: () => ({ createdAt: new Date(), updatedAt: new Date() }),
+  })
+  clips = installFakeModel(TrackClip, {
+    unique: ['uploadId'],
+    defaults: () => ({ createdAt: new Date() }),
+  })
+  submissions = installFakeModel(Submission)
+  stored = []
+  plantingUploads = 0
+  SubmissionService.prototype.uploadClip = (async () => {
+    plantingUploads++
+    throw new Error('a track clip must never be stored as a planting')
+  }) as never
+  trackService.deps = {
+    configured: () => true,
+    upload: async (filePath, objectName, _mime, downloadFilename) => {
+      stored.push({
+        objectName,
+        downloadFilename,
+        bytes: fs.readFileSync(filePath),
+      })
+      return {
+        videoCID: objectName,
+        publicUrl: `https://storage.example/${objectName}`,
+      }
+    },
+    remove: async () => undefined,
+  }
+})
+
+afterEach(async () => {
+  await processingSettled()
+  sessions.restore()
+  clips.restore()
+  submissions.restore()
+  SubmissionService.prototype.uploadClip = saved.uploadClip
+  trackService.deps = saved.deps
+})
+
+async function api(
+  method: string,
+  route: string,
+  opts: { json?: unknown; body?: Buffer; device?: string | null } = {},
+) {
+  const headers: Record<string, string> = {}
+  const who = opts.device === undefined ? device : opts.device
+  if (who) headers['x-track-device'] = who
+  if (opts.json !== undefined) headers['content-type'] = 'application/json'
+  if (opts.body) headers['content-type'] = 'application/octet-stream'
+  const res = await fetch(`${base}/api/track${route}`, {
+    method,
+    headers,
+    body:
+      opts.json !== undefined ? JSON.stringify(opts.json) : (opts.body as any),
+  })
+  const text = await res.text()
+  let json: any = null
+  try {
+    json = JSON.parse(text)
+  } catch {
+    json = text
+  }
+  return { status: res.status, json, headers: res.headers }
+}
+
+function clipBody(type: 'land' | 'plant', uploadId: string, size: number) {
+  return {
+    uploadId,
+    type,
+    size,
+    mimeType: 'video/mp4',
+    fileName: `${type}.mp4`,
+    latitude: -4.57227,
+    longitude: 39.28056,
+    gpsAccuracy: 8,
+    clientGroupId: 'tree-1',
+    planterName: 'Amina Hassan',
+    recordedAt: new Date().toISOString(),
+  }
+}
+
+/** Create, send in one chunk, complete; wait for the server to store it. */
+async function send(
+  body: Record<string, unknown>,
+  bytes: Buffer,
+  who: string = device,
+) {
+  const created = await api('POST', '/uploads', {
+    json: { ...body, size: bytes.length },
+    device: who,
+  })
+  assert.ok([200, 201].includes(created.status), JSON.stringify(created.json))
+  const id = String(body.uploadId)
+  await api('PUT', `/uploads/${id}/chunks?offset=0`, {
+    body: bytes,
+    device: who,
+  })
+  await api('POST', `/uploads/${id}/complete`, { json: {}, device: who })
+  await processingSettled()
+  return api('GET', `/uploads/${id}`, { device: who })
+}
+
+const landBytes = () => Buffer.from(`land footage ${counter}-${Math.random()}`)
+const plantBytes = () =>
+  Buffer.from(`plant footage ${counter}-${Math.random()}`)
+
+test('chunks to /api/track/uploads skip the app body parsers too', () => {
+  const req = {
+    method: 'PUT',
+    originalUrl: `/api/track/uploads/${nextId()}/chunks`,
+  }
+  assert.equal(isUploadChunkRequest(req as any), true)
+})
+
+test('an upload with no tracking id is turned away before anything is kept', async () => {
+  const r = await api('POST', '/uploads', {
+    json: clipBody('land', nextId(), 10),
+    device: null,
+  })
+  assert.equal(r.status, 400)
+  assert.equal(r.json.code, 'TRACK_DEVICE_MISSING')
+  assert.equal(sessions.store.docs.length, 0)
+})
+
+test('a land then a plant clip make one tree with both videos, no planting', async () => {
+  const land = await send(clipBody('land', nextId(), 0), landBytes())
+  assert.equal(land.json.data.state, 'done')
+  const treeId = land.json.data.result.submissionId
+  assert.match(treeId, /^[a-f0-9]{24}$/)
+  assert.equal(land.json.data.result.status, 'awaiting_plant')
+
+  const plant = await send(
+    { ...clipBody('plant', nextId(), 0), treeType: 'Neem', treesPlanted: 3 },
+    plantBytes(),
+  )
+  assert.equal(plant.json.data.state, 'done', JSON.stringify(plant.json))
+  assert.equal(plant.json.data.result.submissionId, treeId)
+  assert.equal(plant.json.data.result.status, 'tracked')
+
+  assert.equal(plantingUploads, 0)
+  assert.equal(submissions.store.docs.length, 0)
+  assert.equal(clips.store.docs.length, 2)
+  assert.ok(
+    sessions.store.docs.every(
+      s => s.channel === 'track' && s.wallet === `track:${device}`,
+    ),
+  )
+
+  const list = await api('GET', '/trees', { device: null })
+  assert.equal(list.status, 200)
+  const [tree] = list.json.data.trees
+  assert.equal(tree.id, treeId)
+  assert.equal(tree.number, 1)
+  assert.equal(tree.planterName, 'Amina Hassan')
+  assert.equal(tree.complete, true)
+  assert.equal(tree.treeType, 'Neem')
+  assert.equal(tree.count, 3)
+  assert.equal(tree.countSource, 'planter')
+  assert.match(
+    tree.land.downloadFilename,
+    /^treegens-track-.*-amina-hassan-.*-before\.mp4$/,
+  )
+  assert.match(tree.plant.downloadFilename, /-after\.mp4$/)
+  assert.ok(tree.land.downloadUrl.startsWith('https://storage.example/track/'))
+  assert.deepEqual(tree.gps, {
+    latitude: -4.57227,
+    longitude: 39.28056,
+    accuracyMeters: 8,
+  })
+  // The phone's id never leaves the server.
+  assert.equal(JSON.stringify(list.json).includes(device), false)
+  const totals = list.json.data.totals
+  assert.equal(totals.trees, 1)
+  assert.equal(totals.planted, 3)
