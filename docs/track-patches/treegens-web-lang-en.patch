@@ -0,0 +1,95 @@
+/**
+ * Who films at treegens.app/track: this phone, and the name its planter
+ * typed. There is no account and no wallet behind either.
+ *
+ * The phone's id is a random UUID minted once and kept in localStorage. The
+ * backend scopes a phone's upload sessions to it (`x-track-device`), the way
+ * a wallet scopes a planter's, so this phone's plant clip finds this phone's
+ * land clip and no other. It is not secret and is never shown.
+ *
+ * Language-neutral: shared byte for byte by the three language builds.
+ */
+
+/** Carried on a queued clip, its draft and its queue row. */
+export interface TrackOwner {
+  device: string
+  planterName?: string
+}
+
+const DEVICE_KEY = 'tg_track_device'
+const NAME_KEY = 'tg_track_planter_name'
+const UUID_RE =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
+
+/** The header the backend reads the phone's id from. */
+export const TRACK_DEVICE_HEADER = 'x-track-device'
+/** The resumable upload API for /track clips. */
+export const TRACK_UPLOADS_PATH = '/api/track/uploads'
+
+function storage(): Storage | null {
+  try {
+    return typeof localStorage === 'undefined' ? null : localStorage
+  } catch {
+    return null
+  }
+}
+
+function mintUuid(): string {
+  if (typeof crypto !== 'undefined' && crypto.randomUUID) {
+    return crypto.randomUUID()
+  }
+  const bytes = new Uint8Array(16)
+  crypto.getRandomValues(bytes)
+  bytes[6] = (bytes[6] & 0x0f) | 0x40
+  bytes[8] = (bytes[8] & 0x3f) | 0x80
+  const hex = [...bytes].map(b => b.toString(16).padStart(2, '0')).join('')
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`
+}
+
+/** In memory too: a phone with no localStorage keeps one id per page. */
+let memoryDevice: string | null = null
+
+/** This phone's tracking id, minted the first time it is asked for. */
+export function trackDeviceId(): string {
+  const store = storage()
+  const kept = store?.getItem(DEVICE_KEY) ?? memoryDevice
+  if (kept && UUID_RE.test(kept)) return kept.toLowerCase()
+  const id = mintUuid().toLowerCase()
+  memoryDevice = id
+  try {
+    store?.setItem(DEVICE_KEY, id)
+  } catch {
+    // Full or blocked: this page's id still links this sitting's clips.
+  }
+  return id
+}
+
+export function isTrackDeviceId(id: unknown): id is string {
+  return typeof id === 'string' && UUID_RE.test(id)
+}
+
+/** The planter's name, as last typed on this phone. */
+export function readPlanterName(): string {
+  return (storage()?.getItem(NAME_KEY) ?? '').slice(0, 120)
+}
+
+export function savePlanterName(name: string): void {
+  try {
+    storage()?.setItem(NAME_KEY, name.trim().slice(0, 120))
+  } catch {
+    // Not kept: asked again next time.
+  }
+}
+
+/** A clip's owner as it can be trusted from a stored row or draft. */
+export function sanitizeTrackOwner(raw: unknown): TrackOwner | undefined {
+  if (!raw || typeof raw !== 'object') return undefined
+  const { device, planterName } = raw as Record<string, unknown>
+  if (!isTrackDeviceId(device)) return undefined
+  const name =
+    typeof planterName === 'string' ? planterName.trim().slice(0, 120) : ''
+  return {
+    device: device.toLowerCase(),
+    ...(name ? { planterName: name } : {}),
+  }
+}
