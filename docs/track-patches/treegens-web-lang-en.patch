+                claim lands and looks like a sixth of what they expected. */}
+            {track ? null : <MgroVestingNote className="mt-4" />}
+          </section>
+        ) : null}
+
+        {isPlantStep && !isFullySubmitted ? (
+          <div className="mb-4 rounded-xl border border-gray-200 bg-gray-50 p-3">
+            <p className="mb-1.5 text-xs font-bold uppercase tracking-wide text-gray-500">
+              {track ? 'Plant it right' : 'Verifiers will check'}
+            </p>
+            <ul className="flex flex-col gap-1">
+              {[
+                'Planted approx. 30cm apart',
+                'Planted within 2m of the same tree species',
+                'Each tree filmed once, walking one direction',
+                'Propagules old enough & alive',
+              ].map(item => (
+                <li
+                  key={item}
+                  className="flex items-start gap-2 text-[13px] text-gray-700"
+                >
+                  <span aria-hidden className="mt-[1px] text-tree-green-2">
+                    ✓
+                  </span>
+                  {item}
+                </li>
+              ))}
+            </ul>
+          </div>
+        ) : null}
+
+        {(isLandStep || isPlantStep) && !isFullySubmitted ? (
+          <div className="mb-10">
+            <Button
+              type="button"
+              onClick={handlePrimarySubmit}
+              disabled={
+                isQueueing ||
+                isAskingLocation ||
+                // The clip previews instantly while checks run behind it.
+                // Submit waits for them, so a clip this phone cannot read
+                // is said so before it goes (it is kept either way).
+                validatingType !== null ||
+                !!validationError ||
+                (isLandStep && !landClip) ||
+                (isPlantStep &&
+                  (!plantClip ||
+                    !hasPlantSubmissionLink ||
+                    !plantDetailsComplete))
+              }
+              pill
+              color="success"
+              className="w-full"
+            >
+              {isAskingLocation
+                ? 'Asking for location…'
+                : isQueueing
+                  ? 'Submitting…'
+                  : 'Submit'}
+            </Button>
+            {uploadError ? (
+              <p className="mt-3 text-center text-sm text-red-600">
+                {uploadError}
+              </p>
+            ) : null}
+          </div>
+        ) : null}
+
+        <div className="border-t border-gray-200 pt-4">
+          <p className="mb-3 text-sm font-semibold text-gray-700">
+            Tips for a good video
+          </p>
+          <ul className="flex flex-col gap-3">
+            {guidelines.map((g, i) => (
+              <li key={g.title} className="flex flex-row gap-3">
+                <span className="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#E8F7ED] text-xs font-semibold text-tree-green-2">
+                  {i + 1}
+                </span>
+                <div>
+                  <p className="text-sm font-medium text-gray-800">{g.title}</p>
+                  <p className="mt-0.5 text-sm text-gray-500">
+                    {g.description}
+                  </p>
+                </div>
+              </li>
+            ))}
+          </ul>
+        </div>
+
+        {!hasValidLocation() && !locationLoading ? (
+          <p className="mt-2 text-center text-sm text-orange-600">
+            Location not found yet - tapping Submit will ask again.
+          </p>
+        ) : null}
+
+        {isPlantStep &&
+        plantClip &&
+        hasPlantSubmissionLink &&
+        !plantDetailsComplete ? (
+          <p className="mt-2 text-center text-sm text-orange-600">
+            {mangroveAnswer === null
+              ? 'Answer the mangrove question above.'
+              : 'Enter tree count (≥1) and tree type.'}
+          </p>
+        ) : null}
+
+        {isPlantStep && plantClip && !hasPlantSubmissionLink ? (
+          <p className="mt-2 text-center text-sm text-orange-600">
+            Land must be queued or uploaded first so plant can be linked. Go
+            back to step 1 and submit land again.
+          </p>
+        ) : null}
+      </div>
+
+      <CameraRecorder
+        open={recorderFor !== null}
+        title={recorderFor === VideoType.LAND ? 'Land video' : 'Plant video'}
+        slot={recorderFor ? slotFor(recorderFor) : undefined}
+        groupId={
+          recorderFor === VideoType.PLANT
+            ? linkedGroupId() || undefined
+            : undefined
+        }
+        onStart={() => {
+          if (recorderFor) handleFilmingStart(recorderFor)
+        }}
+        onStop={() => {
+          if (recorderFor) markFilmingEnd(recorderFor)
+        }}
+        onRecorded={(file, recordingSessionId) => {
+          const type = recorderFor
+          setRecorderFor(null)
+          if (type) {
+            handleVideoRecorded(file, type, 'in-page', recordingSessionId)
+          } else if (recordingSessionId) {
+            // No clip slot open to take it: its pieces stay on the phone
+            // and come back as a draft the next time a filming screen opens.
+            void abandonRecording(recordingSessionId)
+          }
+        }}
+        onCancel={() => setRecorderFor(null)}
+        onFallback={why => {
+          if (recorderFor) openCameraApp(recorderFor, why)
+        }}
+        gpsFix={latestFix}
+      />
+      {gpsGate.dialog}
+    </div>
+  )
+}
