-function formatUploadError(error: unknown, fallback: string): string {
-  const raw = error instanceof Error ? error.message : ''
-  // Device disk full — tell the planter how to recover instead of showing a
-  // raw browser exception.
-  if (
-    raw === 'DEVICE_STORAGE_FULL' ||
-    /quota/i.test(raw) ||
-    (error as { name?: string })?.name === 'QuotaExceededError'
-  ) {
-    return 'Your device storage is full. Please free up space (photos/apps) or try again when you are online.'
-  }
-  if (axios.isAxiosError(error)) {
-    const data = error.response?.data as
-      | { error?: string; message?: string }
-      | undefined
-    return data?.error || data?.message || error.message || fallback
-  }
-  if (error instanceof Error) return error.message
-  return fallback
-}
