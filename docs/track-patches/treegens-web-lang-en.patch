+// --- /track (no crypto) ------------------------------------------------------
+
+const TRACK = {
+  device: '0a1b2c3d-0000-4000-8000-000000000001',
+  planterName: 'Amina',
+}
+const TRACK_BASE = '/api/track/uploads'
+
+/** The same fake backend, answering at the /track route instead. */
+function trackRoute() {
+  const seen = []
+  http.hooks.handle = (method, url, data, config) => {
+    seen.push({ method, url, headers: config?.headers || {} })
+    if (!url.startsWith(TRACK_BASE)) {
+      return Promise.reject(httpError(404, {}))
+    }
+    return server.handle(method, BASE + url.slice(TRACK_BASE.length), data, config)
+  }
+  return seen
+}
+
+test('a /track clip goes to its own route under the phone id, with its planter', async () => {
+  const seen = trackRoute()
+  const { file, bytes } = clipFile(3000)
+  const result = await uploadClip(landClip(file, { track: TRACK }), {
+    timings: { ...FAST, growUnderMs: 0 },
+  })
+  assert.deepEqual(result, { kind: 'processing' })
+  assert.deepEqual(Array.from(server.sessions.get(UUID).bytes), Array.from(bytes))
+  assert.ok(seen.length >= 3)
+  for (const r of seen) {
+    assert.ok(r.url.startsWith(TRACK_BASE), `${r.method} ${r.url}`)
+    assert.equal(r.headers['x-track-device'], TRACK.device)
+  }
+  assert.equal(server.sessions.get(UUID).init.planterName, 'Amina')
+
+  await pollStatus(UUID, { timings: FAST, track: TRACK })
+  await abandonUpload(UUID, { timings: FAST, track: TRACK })
+  assert.ok(seen.slice(-2).every(r => r.url.startsWith(TRACK_BASE)))
+})
+
+test('a backend without /track keeps the clip for later, and plantings off the old route', async () => {
+  http.hooks.handle = async () => {
+    throw httpError(404, {})
+  }
+  const result = await uploadClip(
+    landClip(clipFile(1000).file, { track: TRACK }),
+    { timings: FAST },
+  )
+  assert.equal(result.kind, 'transient')
+  assert.equal(usingLegacyUpload(), false, 'plantings are not sent the old way')
+})
+
+test('a planting never carries a phone id or a planter name', async () => {
+  const seen = []
+  const handle = server.handle
+  http.hooks.handle = (method, url, data, config) => {
+    seen.push(config?.headers || {})
+    return handle(method, url, data, config)
+  }
+  await uploadClip(landClip(clipFile(1500).file), { timings: FAST })
+  assert.ok(seen.every(h => !('x-track-device' in h)))
+  assert.equal('planterName' in server.sessions.get(UUID).init, false)
+})
+
