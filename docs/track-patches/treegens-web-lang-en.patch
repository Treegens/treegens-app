@@ -0,0 +1,104 @@
+import { axiosInstance } from './axiosInstance'
+
+/**
+ * The /track dashboard's reads (treegens.app/track/dashboard). Public
+ * endpoints on the backend: no wallet, no JWT. The clips themselves go up
+ * through the upload queue (uploadManager, `track` clips).
+ *
+ * Language-neutral: shared byte for byte by the three language builds.
+ */
+
+export type TrackCountSource = 'planter' | 'ai' | 'ai_pending' | 'none'
+
+export interface TrackGps {
+  latitude: number
+  longitude: number
+  accuracyMeters?: number
+}
+
+export interface TrackClip {
+  id: string
+  kind: 'land' | 'plant'
+  publicUrl: string
+  downloadUrl: string
+  downloadFilename: string
+  mimeType?: string
+  sizeBytes?: number
+  gps?: TrackGps
+  gpsEnd?: string
+  gpsPathPoints?: number
+  reverseGeocode?: string
+  filmedAt: string
+  uploadedAt: string
+}
+
+export interface TrackTree {
+  id: string
+  number: number
+  planterName?: string
+  filmedAt: string
+  gps?: TrackGps
+  reverseGeocode?: string
+  treeType?: string
+  isMangrove: boolean
+  treesPlanted?: number
+  ai?: {
+    status: 'pending' | 'counting' | 'done' | 'failed' | 'skipped'
+    treeCount?: number
+    videoUrl?: string
+    error?: string
+  }
+  count: number
+  countSource: TrackCountSource
+  complete: boolean
+  land: TrackClip
+  plant?: TrackClip
+}
+
+export interface TrackTotals {
+  trees: number
+  awaitingPlant: number
+  planted: number
+  aiPending: number
+  clips: number
+  bytes: number
+  planters: { name: string; trees: number; planted: number }[]
+}
+
+export interface TrackTreeList {
+  trees: TrackTree[]
+  pagination: { page: number; limit: number; total: number; totalPages: number }
+  totals: TrackTotals
+}
+
+const apiBase = () =>
+  String(axiosInstance.defaults.baseURL || '').replace(/\/+$/, '')
+
+export const trackApi = {
+  async listTrees(params: {
+    page?: number
+    limit?: number
+    planter?: string
+    from?: Date
+    to?: Date
+  }): Promise<TrackTreeList> {
+    const res = await axiosInstance.get<{ data: TrackTreeList }>(
+      '/api/track/trees',
+      {
+        params: {
+          page: params.page ?? 1,
+          limit: params.limit ?? 50,
+          ...(params.planter ? { planter: params.planter } : {}),
+          ...(params.from ? { from: params.from.toISOString() } : {}),
+          ...(params.to ? { to: params.to.toISOString() } : {}),
+        },
+      },
+    )
+    return res.data.data
+  },
+
+  /** Every tree as a spreadsheet: who, where, when, the count, both URLs. */
+  csvUrl: () => `${apiBase()}/api/track/trees.csv`,
+  /** One video URL per line: `wget --content-disposition -i urls.txt`. */
+  urlListUrl: () => `${apiBase()}/api/track/urls.txt`,
