# Copy to `.env` — do not commit secrets.

MONGODB_URI=
# Optional. The Atlas cluster is shared with the other Treegens backends, which
# have different schemas. Set this to keep our collections in their own
# database regardless of the database named in MONGODB_URI. Production uses
# treegens-app.
MONGODB_DB_NAME=

# Optional. Comma-separated CORS allowlist, e.g.
#   https://treegens.app,https://world.treegens.app
# Leave empty to accept any origin.
CORS_ORIGINS=

# --- Media storage: Google Cloud Storage (sole backend; Pinata/IPFS removed) ---
# Bucket name for uploaded verification videos.
GCS_BUCKET=
# Full service-account key JSON as a single string (raw JSON or base64 JSON).
# Omit to use Application Default Credentials when running on GCP.
GCS_SERVICE_ACCOUNT_JSON=

# --- Mangrove plant video AI verification ---

# treegens_ml: self-hosted FastAPI + YOLO on port 8000 (recommended on VPS; no Roboflow credits)
# ultralytics: Bearer + multipart `/predict` (Cloud Run or Ultralytics Platform)
# roboflow_workflow: Roboflow Serverless JSON workflow
AI_PROVIDER=treegens_ml

# Self-hosted planting verifier (`treegens-app` / Mangrove Planting Proof API)
PLANTING_VERIFICATION_API_URL=http://127.0.0.1:8000
# Must match FastAPI INTERNAL_API_KEY (same value on both services)
PLANTING_VERIFICATION_INTERNAL_KEY=

# When treegens_ml is primary: retry Ultralytics /predict on timeout or 5xx
# AI_FAILOVER_TO_ULTRALYTICS=true

AI_API_BASE_URL=https://app.buildingculture.capital
AI_API_BEARER_TOKEN=
# Base + path, OR set a full predict URL (e.g. Cloud Run) — wins over BASE+VERIFY_PATH:
# AI_API_PREDICT_URL=https://your-service-xxx.run.app/predict
AI_API_VERIFY_PATH=
# Multipart field for video — Cloud Run snippets often use `file` instead of `video`
AI_VIDEO_FORM_FIELD_NAME=file
# Ultralytics /predict: send midpoint JPEG (WebCam WebM / MP4) like `curl -F file=@image.jpg`
# Set multipart_video only if your endpoint accepts raw video bytes.
AI_ULTRALYTICS_INPUT_MODE=middle_frame_jpeg
# Ultralytics-style predict optional params (matches browser FormData)
# AI_PREDICT_CONF=0.25
# AI_PREDICT_IOU=0.7
# AI_PREDICT_IMGSZ=640
# Set false if `/predict` rejects extra fields (only file + params are sent)
# AI_API_SEND_SUBMISSION_METADATA=true
AI_REQUEST_TIMEOUT_MS=120000

# Comma-separated dotted paths for count / confidence in JSON responses (optional overrides)
# AI_RESPONSE_COUNT_PATHS=mangrove_count,outputs.mangrove_count,count
# AI_RESPONSE_CONFIDENCE_PATHS=confidence,data.confidence
# Video: if the model returns a per-frame `outputs` or `results` array, counts are combined with
# `max` by default (avoids summing the same seedlings in every frame). Use `sum` only if each row
# is meant to add disjoint detections.
# AI_RESPONSE_OUTPUTS_AGGREGATION=max
# Root JSON field names to skip when multiple frames exist but rows had no parseable count
# (usually cumulative video totals). Comma-separated; matches full path or last path segment.
# AI_RESPONSE_CUMULATIVE_COUNT_PATHS=totalDetections,detected

# When the model returns `detections` with `bbox` tuples, TreeGens prefers NMS dedup over raw seedling_count.
# Tune if counts are too high (lower IoU, higher min confidence, lower max-area) or too low (reverse).
# AI_DETECTION_NMS_IOU=0.32
# AI_DETECTION_MAX_BOX_AREA_FRACTION=0.22
# AI_DETECTION_MIN_CONFIDENCE=0.88
# (use 0 to skip the min-confidence pre-filter)

# --- Roboflow (only when AI_PROVIDER=roboflow_workflow) ---

ROBOFLOW_API_URL=https://serverless.roboflow.com
# Roboflow private key; if empty, AI_API_BEARER_TOKEN is reused when set
ROBOFLOW_API_KEY=

# Provide exactly one routing option:

# Full POST URL override (“copy URL” from Roboflow)
# ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/zeroxleonardos-workspace/workflows/mangrove-planting-proof-verifier-1777557655867

# Or workspace + deployed workflow id (same URL as InferenceHTTPClient named workflow)
# ROBOFLOW_WORKSPACE_NAME=zeroxleonardos-workspace
# ROBOFLOW_WORKFLOW_ID=mangrove-planting-proof-verifier-1777557655867

# Or inline specification file for https://serverless.roboflow.com/workflows/run
# ROBOFLOW_WORKFLOW_SPEC_PATH=/absolute/or/relative/path/workflow-spec.json

AI_ROBOFLOW_CONFIDENCE=0.96
AI_ROBOFLOW_IMAGE_FIELD=image

# Match minimal browser JSON: only api_key + inputs.image (set all three)
# AI_ROBOFLOW_SEND_CONFIDENCE=false
# AI_ROBOFLOW_SEND_VIDEOMETA=false
# AI_ROBOFLOW_MINIMAL_REQUEST=true

# Server default: middle-frame JPEG as inputs.image { type: "base64", value }.
# Optional: pass verifyMangrovePlantVideo({ workflowImageUrl }) for { type: "url", value } instead.

# Optional extra JSON merged into workflow inputs as `videometa`
# AI_ROBOFLOW_VIDEOMETA_JSON={"note":"submission metadata"}

# Set to false if the workflow has no WorkflowVideoMetadata input
# AI_ROBOFLOW_SEND_VIDEOMETA=true

# --- Site Check (register a site before planting mangroves) ---

# What a missing or unfavourable Site Check does to a mangrove planting:
#   off      record it only (default, collect data)
#   warn     never block, but AI auto-approvals go to verifiers instead
#   enforce  refuse the plant upload with a plain explanation
# SITE_CHECK_ENFORCEMENT=off
# Largest site a planter may register, in square metres (default 500000 = 50 ha, min 50).
# SITE_MAX_AREA_M2=500000
# A land clip filmed this many metres outside the site boundary still counts as inside.
# SITE_GPS_TOLERANCE_M=50

# Satellite hydrology check (Sentinel-2, public AWS open data, no key needed).
# Set false to skip it; sites are then judged on the field answers alone.
# SITE_HYDROLOGY_ENABLED=true
# Years of imagery per site (1 to 5).
# SITE_HYDROLOGY_YEARS=2
# How far around the site to look for natural mangroves, in metres (500 to 5000).
# SITE_HYDROLOGY_REFERENCE_RADIUS_M=1500
# Skip tiles cloudier than this percentage (10 to 100).
# SITE_HYDROLOGY_MAX_CLOUD_PCT=80
# Images read in parallel per site (1 to 16).
# SITE_HYDROLOGY_SCENE_CONCURRENCY=8
# Time budget per site in ms (30000 to 900000). It classifies with what it has read by then.
# SITE_HYDROLOGY_TIMEOUT_MS=300000
# Runs per site before the sweeper gives up (1 to 10). A recheck from the app resets it.
# SITE_HYDROLOGY_MAX_ATTEMPTS=3
# SITE_HYDROLOGY_S2_BUCKET_URL=https://sentinel-cogs.s3.us-west-2.amazonaws.com
# SITE_HYDROLOGY_WORLDCOVER_URL=https://esa-worldcover.s3.eu-central-1.amazonaws.com
# Every 5 minutes, retry satellite checks a restart interrupted or a failure left retryable.
# ENABLE_SITE_HYDROLOGY_SWEEPER=true

# --- Delegation (off-chain verifier vote proxy) ---

# When true, POST /api/users/me/delegate requires min on-chain staked TGN (RPC + vault).
# Default unset/false: any signed-in user may delegate to an existing verifier wallet.
# DELEGATION_REQUIRE_MIN_STAKED_TGN=true

# Leaderboard: when true and NODE_ENV is not production, empty leaderboards return demo rows (prototype).
# LEADERBOARD_DEMO_FALLBACK=true

# --- API / auth (read via src/config/environment.ts) ---

API_BASE_URL=http://localhost:5000/api/v1
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Base mainnet + TreeGens on-chain (defaults match web `NEXT_PUBLIC_*` — keep in sync) ---

# JSON-RPC for Base mainnet — verifier, MGRO mint, slash worker, burn indexer
# ⚠️ MAINNET ONLY. Do not point this at Base Sepolia in production.
BASE_RPC_URL=https://mainnet.base.org
# Deprecated testnet aliases (still read if BASE_RPC_URL is unset) — leave blank:
# BASE_SEPOLIA_RPC_URL=
# RPC_URL=

# TGN staking vault + ERC20 (defaults match web / Base mainnet deploy when unset)
# TGN_VAULT_ADDRESS=0x64b05503c6F2233d279E6B8B8f2Da6936dEd584C
# TGN_TOKEN_ADDRESS=0xD75dfa972C6136f1c594Fec1945302f885E1ab29
# TGN_DECIMALS=18
# VALIDATORS_MINIMUM_TGN_TOKENS=2000

# DAO + MGRO rewards (reward claim worker, indexer — see `src/config/environment.ts`)
# DAO_CONTRACT_ADDRESS=
# $MGRO on Base mainnet. The minter wallet must hold MINTER_ROLE on this token,
# otherwise reward mints revert. Mainnet exposes mint(); legacy used mintTokens().
MGRO_TOKEN_ADDRESS=0x46e564D039d0d7Ec4C88d517fD32a03d15e88568
# MGRO_DECIMALS=18
# MGRO_MINTER_PRIVATE_KEY=
# MGRO_CLAIM_INTERVAL=
# MGRO_CLAIM_COUNT=
# MGRO_BURN_START_BLOCK=

# Vault slasher bot (optional)
# TGN_VAULT_SLASHER_PRIVATE_KEY=

# --- Background workers (Render) ---
# The API service must NOT run the workers in-process. They are deployed as
# their own Render Background Workers, which set these to 'true' themselves.
ENABLE_REWARD_CLAIM_WORKER=false
ENABLE_SLASH_WORKER=false

# Redis (Render Key Value) — required by BullMQ for the reward-claim and slash
# queues. Use the INTERNAL connection string when the worker is on Render.
# REDIS_URL=redis://red-xxxxxxxx:6379

# --- world.treegens.app integration ---
# Shared secret for /api/distributions/* (service-to-service only, never a
# browser). Must match DISTRIBUTOR_API_KEY on the world.treegens.app site.
# Routes stay disabled while this is unset.
# DISTRIBUTOR_API_KEY=

# --- Integrations (optional; exposed on `env` — wire routes as needed) ---

# ROBOFLOW_PUBLIC_API_KEY=
# Server-side Thirdweb (Engine / admin — not the same as web Client ID)
# THIRDWEB_SECRET_KEY=
# THIRDWEB_PROJECT_ID=
# TELEGRAM_BOT_TOKEN=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# NEYNAR_API_KEY=
# LANGBASE_API_KEY=
# LLM_API_KEY=

# --- Ops metadata (not served by API) ---

# VPS_IP=
# VPS_USERNAME=
# BACKEND_URL=
# DOCKER_IMAGE=

# --- Web Push (VAPID) — inbox notifications ---
# Generate keys: `npx web-push generate-vapid-keys`
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=mailto:you@example.com

# --- Social quests ---
# Task list + point values live in `src/constants/socialRewardsCatalog.ts` (DB stores completions + socialPointsTotal).
